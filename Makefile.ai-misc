# Miscellaneous script/utility targets extracted from Makefile.ai

PORT ?= 9103
ADMIN_TOKEN ?= your_admin_token_here  # Set this to a valid admin token for protected endpoints

# --- Test Environment Targets ---
misc-test-export-rules:
	python scripts/export_approved_rules.py

misc-test-lint-rules:
	python scripts/lint_rules.py

misc-test-propose-rule:
	curl -s -X POST http://localhost:$(PORT)/propose-rule-change \
	  -H "Content-Type: application/json" \
	  -d @$(RULE_FILE)

misc-test-list-rules:
	docker compose -f docker-compose.test.yml exec test-db psql -U postgres -d rulesdb -c "SELECT * FROM proposals;" | cat
	docker compose -f docker-compose.test.yml exec test-db psql -U postgres -d rulesdb -c "SELECT * FROM rules;" | cat

# --- Dev/Default Environment Targets ---
misc-export-rules:
	python scripts/export_approved_rules.py

misc-lint-rules:
	python scripts/lint_rules.py

misc-propose-rule:
	curl -s -X POST http://localhost:$(PORT)/propose-rule-change \
	  -H "Content-Type: application/json" \
	  -d @$(RULE_FILE)

misc-list-rules:
	docker compose exec db psql -U postgres -d rulesdb -c "SELECT * FROM proposals;" | cat
	docker compose exec db psql -U postgres -d rulesdb -c "SELECT * FROM rules;" | cat
	docker compose exec db psql -U postgres -d rulesdb -c "SELECT * FROM feedback;" | cat

misc-list-rules-mdc:
	curl -s http://localhost:$(PORT)/rules.mdc

misc-review-code-files:
	curl -s -X POST http://localhost:$(PORT)/review-code-files \
	  -F "files=@$(FILE)"

misc-review-code-snippet:
	curl -s -X POST http://localhost:$(PORT)/review-code-snippet \
	  -H "Content-Type: application/json" \
	  -d '{"filename": "$(FILENAME)", "code": "$(CODE)"}'

misc-scan-db:
	echo '--- Proposals ---'; sqlite3 rules.db 'SELECT * FROM proposals;'; \
	echo '\n--- Rules ---'; sqlite3 rules.db 'SELECT * FROM rules;'; \
	echo '\n--- Feedback ---'; sqlite3 rules.db 'SELECT * FROM feedback;'

misc-approve-all-pending:
	python scripts/approve_all_pending.py

misc-propose-makefile-rule:
	curl -s -X POST http://localhost:$(PORT)/propose-rule-change \
	  -H "Content-Type: application/json" \
	  -d '{ \
	    "rule_type": "$(RULE_TYPE)", \
	    "description": "$(DESCRIPTION)", \
	    "diff": "$(DIFF)", \
	    "submitted_by": "$(SUBMITTED_BY)", \
	    "categories": [$(CATEGORIES)], \
	    "tags": [$(TAGS)], \
	    "project": "$(PROJECT)", \
	    "applies_to": [$(APPLIES_TO)], \
	    "applies_to_rationale": "$(APPLIES_TO_RATIONALE)", \
	    "examples": "$(EXAMPLES)", \
	    "reason_for_change": "$(REASON_FOR_CHANGE)", \
	    "references": "$(REFERENCES)", \
	    "current_rule": "$(CURRENT_RULE)" \
	  }'

misc-review-multiple-files:
	python scripts/review_multiple_files.py $(FILES)

misc-propose-rules:
	bash misc_scripts/propose_rules.sh

misc-install:
	docker compose exec misc-scripts pip install -r requirements.txt

misc-up:
	docker compose up -d misc-scripts

misc-update-rules:
	$(MAKE) -f Makefile.ai misc-up
	docker compose exec misc-scripts pip install -r requirements.txt
	docker compose exec misc-scripts python update_rules.py

misc-generate-update-template:
	docker compose exec misc-scripts python generate_rules_update_template.py

misc-mdc-to-json: misc-install
	docker compose exec misc-scripts python mdc_to_json_rule_proposals.py

misc-enrich-rules:
	docker compose exec misc-scripts python enrich_rule_proposals.py

misc-build:
	docker compose build misc-scripts

misc-update-missing-user-stories:
	docker compose exec misc-scripts python /scripts/update_missing_user_stories.py

misc-restart:
	docker compose restart misc-scripts

misc-propose-portable-rule:
	curl -s -X POST http://localhost:$(API_PORT)/propose-rule-change \
	  -H 'Content-Type: application/json' \
	  -d '{ \
	    "rule_type": "$(RULE_TYPE)", \
	    "description": "$(DESCRIPTION)", \
	    "diff": "$(DIFF)", \
	    "submitted_by": "$(SUBMITTED_BY)", \
	    "categories": [$(CATEGORIES)], \
	    "tags": [$(TAGS)], \
	    "project": "$(PROJECT)", \
	    "reason_for_change": "$(REASON_FOR_CHANGE)", \
	    "references": "$(REFERENCES)", \
	    "current_rule": "$(CURRENT_RULE)" \
	  }'

misc-bug-report:
	curl -s -X POST http://localhost:$(PORT)/bug-report \
	  -H 'Content-Type: application/json' \
	  -d '{"description": "$(DESCRIPTION)", "reporter": "$(REPORTER)", "page": "$(PAGE)"}'

misc-bug-report-test:
	$(MAKE) -f Makefile.ai misc-bug-report \
	  DESCRIPTION='Test bug report from Makefile' \
	  REPORTER='cli-test' \
	  PAGE='/admin'

misc-suggest-enhancement:
	curl -s -X POST http://localhost:$(PORT)/suggest-enhancement \
	  -H 'Content-Type: application/json' \
	  -d '{"description": "$(DESCRIPTION)", "suggested_by": "$(SUGGESTED_BY)", "page": "$(PAGE)", "tags": [$(TAGS)], "categories": [$(CATEGORIES)]}'

misc-suggest-enhancement-test:
	$(MAKE) -f Makefile.ai misc-suggest-enhancement \
	  DESCRIPTION='Test enhancement from Makefile' \
	  SUGGESTED_BY='cli-test' \
	  PAGE='/admin' \
	  TAGS='"cli","test"' \
	  CATEGORIES='"usability"'

misc-enhancement-to-proposal:
	curl -s -X POST http://localhost:$(PORT)/enhancement-to-proposal/$(ENHANCEMENT_ID)

misc-proposal-to-enhancement:
	curl -s -X POST http://localhost:$(PORT)/proposal-to-enhancement/$(PROPOSAL_ID)

misc-accept-enhancement:
	curl -s -X POST http://localhost:$(PORT)/accept-enhancement/$(ENHANCEMENT_ID)

misc-complete-enhancement:
	curl -s -X POST http://localhost:$(PORT)/complete-enhancement/$(ENHANCEMENT_ID)

misc-list-enhancements:
	curl http://$(API_HOST):9103/enhancements | jq

misc-onboarding-health:
	python scripts/onboarding_health_check.py

misc-import-backup:
	docker compose exec api python import_from_backup.py

misc-search-user-stories:
	python3 scripts/search_user_stories.py $(KEYWORD)

misc-fdw-setup-script:
	docker compose exec db-test psql -U postgres -d $(TARGET_DB) -c "CREATE EXTENSION IF NOT EXISTS postgres_fdw;"
	docker compose exec db-test psql -U postgres -d $(TARGET_DB) -c "DROP SERVER IF EXISTS temp_restore_server CASCADE;"
	docker compose exec db-test psql -U postgres -d $(TARGET_DB) -c "CREATE SERVER temp_restore_server FOREIGN DATA WRAPPER postgres_fdw OPTIONS (host='db-test', dbname='$(TEMP_DB)', port='5432');"
	docker compose exec db-test psql -U postgres -d $(TARGET_DB) -c "CREATE USER MAPPING FOR CURRENT_USER SERVER temp_restore_server OPTIONS (user='postgres');"
	docker compose exec db-test psql -U postgres -d $(TARGET_DB) -c "IMPORT FOREIGN SCHEMA public FROM SERVER temp_restore_server INTO temp_schema;"

misc-logs-help:
	@echo "\n==== Log Viewing Quick Reference ===="
	@echo "Ollama backend logs:         make -f Makefile.ai llm-ollama-logs"
	@echo "Ollama gateway logs:         make -f Makefile.ai llm-ollama-functions-logs"
	@echo "API logs:                    make -f Makefile.ai admin-logs-api"
	@echo "Frontend logs:               make -f Makefile.ai admin-logs-frontend"
	@echo "Database logs:               make -f Makefile.ai admin-logs-db"
	@echo "\nAll of these show the last 100 lines of logs for the relevant service."
	@echo "For more, see docs/user_stories/unified_system_startup.md or onboarding docs."
	@echo "==== End Log Viewing Help ===="

misc-remove-duplicate-makefile-targets:
	awk -f scripts/remove_makefile_targets.awk Makefile.ai > Makefile.ai.cleaned && mv Makefile.ai.cleaned Makefile.ai

misc-enhancement-lifecycle-notify:
	docker compose exec misc-scripts python3 /code/misc_scripts/enhancement_lifecycle_notify.py

misc-safe-shutdown:
	@echo "[Safe Shutdown] Backing up rulesdb (data only)..."
	$(MAKE) -f Makefile.ai db-backup-data-only
	@echo "[Safe Shutdown] Backing up memorydb (data only)..."
	$(MAKE) -f Makefile.ai db-memorydb-backup-data-only
	@echo "[Safe Shutdown] (Optional) For full backup, run: make -f Makefile.ai db-backup-all"
	@echo "[Safe Shutdown] Stopping all services..."
	$(MAKE) -f Makefile.ai down
	@echo "[Safe Shutdown] Done. See docs/user_stories/safe_shutdown.md for details."

misc-auto-feedback:
	docker compose exec misc-scripts python /code/misc_scripts/auto_feedback.py

misc-status:
	docker compose ps misc-scripts

misc-logs:
	docker compose logs --tail=50 misc-scripts

misc-healthcheck:
	docker compose exec misc-scripts python /scripts/healthcheck.py

misc-update-project-map:
	docker compose exec misc-scripts python /scripts/update_project_map.py

.PHONY: misc-test-export-rules misc-test-lint-rules misc-test-propose-rule misc-test-list-rules misc-export-rules misc-lint-rules misc-propose-rule misc-list-rules misc-list-rules-mdc misc-review-code-files misc-review-code-snippet misc-scan-db misc-approve-all-pending misc-propose-makefile-rule misc-review-multiple-files misc-propose-rules misc-install misc-up misc-update-rules misc-generate-update-template misc-mdc-to-json misc-enrich-rules misc-build misc-update-missing-user-stories misc-restart misc-propose-portable-rule misc-bug-report misc-bug-report-test misc-suggest-enhancement misc-suggest-enhancement-test misc-enhancement-to-proposal misc-proposal-to-enhancement misc-accept-enhancement misc-complete-enhancement misc-list-enhancements misc-onboarding-health misc-import-backup misc-search-user-stories misc-fdw-setup-script misc-logs-help misc-remove-duplicate-makefile-targets misc-enhancement-lifecycle-notify misc-safe-shutdown misc-auto-feedback misc-status misc-logs misc-healthcheck misc-update-project-map 