+def chunk_text(text, max_tokens=2000):
+    lines = text.splitlines()
+    chunk = []
+    chunks = []
+    count = 0
+    for line in lines:
+        chunk.append(line)
+        count += 1
+        if count >= max_tokens:
+            chunks.append("
".join(chunk))
+            chunk = []
+            count = 0
+    if chunk:
+        chunks.append("
".join(chunk))
+    return chunks
