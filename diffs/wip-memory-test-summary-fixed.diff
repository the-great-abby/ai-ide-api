+@app.post("/summarize-git-diff")
+def summarize_git_diff(
+    diff: str = Body(..., embed=True),
+    concise: bool = Body(False, embed=True)
+):
+    prompt = CONCISE_PROMPT if concise else VERBOSE_PROMPT
+    chunks = chunk_text(diff, max_tokens=2000)
