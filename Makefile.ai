ai-memorydb-restore-data: memorydb-restore-data

# Git History Awareness aliases
ai-git-history-awareness-status: memory-git-history-awareness-status
ai-git-history-awareness-timeline: memory-git-history-awareness-timeline
ai-git-history-awareness-patterns: memory-git-history-awareness-patterns
ai-git-history-awareness-anomalies: memory-git-history-awareness-anomalies
ai-git-history-awareness-trends: memory-git-history-awareness-trends
ai-git-history-awareness-report: memory-git-history-awareness-report
ai-git-history-awareness-export: memory-git-history-awareness-export
ai-git-history-awareness-cleanup: memory-git-history-awareness-cleanup
ai-git-history-awareness-trigger-full: memory-git-history-awareness-trigger-full
ai-git-history-awareness-trigger-custom: memory-git-history-awareness-trigger-custom

# Git History Analysis Management aliases
ai-git-history-status: misc-git-history-status
ai-git-history-logs: misc-git-history-logs
ai-git-history-scheduler-logs: misc-git-history-scheduler-logs
ai-git-history-trigger-daily: misc-git-history-trigger-daily
ai-git-history-trigger-weekly: misc-git-history-trigger-weekly
ai-git-history-trigger-sprint: misc-git-history-trigger-sprint
ai-git-history-trigger-monthly: misc-git-history-trigger-monthly
