# 🏴‍☠️ PIRATE WARNING: This Makefile is the captain's log—keep it lean!
# Only high-level targets and includes belong here. All real work goes in sub-Makefiles.
# If this file grows too large, the ship will sink (build system will crash).
# See Makefile.ai-*, Makefile.ai-test, Makefile.ai-llm, etc. for specialized targets.

PORT ?= 9103
ADMIN_FRONTEND_PORT ?= 3000
API_PORT ?= 9103
MEMORYDB_FILE ?= not_provided
RULESDB_FILE ?= not_provided
BACKUP_FILE ?= not_provided

# TODO: Implement a script for interactive Alembic head-checking and prompting for merges.
# This will help users resolve migration graph conflicts more safely and with better UX.

# Add this near the top with other variable definitions
# OLLAMA_MODEL ?= llama3.1:70b-instruct-q5_K_M
OLLAMA_MODEL ?= llama3.1:8b-instruct-q6_K

PROJECT ?= ai-ide-api

include Makefile.ai-test
include Makefile.ai-llm
include Makefile.ai-misc
include Makefile.ai-db
include Makefile.ai-admin
include Makefile.ai-memory

# High-level aliases (if any) can go here:
# Example:
# test: ai-test
# lint: ai-lint-rules

# End of captain's log.

# --- Core Targets ---
ai-up:
	docker-compose up -d api frontend misc-scripts
	$(MAKE) -f Makefile.ai ai-api-wait
	$(MAKE) -f Makefile.ai ai-up-ollama-functions
	@echo "[ai-up] Core services (API, frontend, Ollama functions, misc-scripts) are up!"

ai-down:
	docker-compose down
	$(MAKE) -f Makefile.ai ai-down-ollama-functions
	@echo "[ai-down] All services (API, frontend, Ollama functions, misc-scripts) have been stopped."

api-up:
	docker compose up -d api db-test

ai-test:
	ENVIRONMENT=test PYTEST_ARGS="$(PYTEST_ARGS)" $(MAKE) -f Makefile.ai-test ai-test

ai-test-json:
	docker-compose run --rm test pytest --json-report --json-report-file=pytest-report.json tests/

ai-test-one:
	docker-compose run --rm test pytest $(TEST) --disable-warnings --tb=short

ai-rebuild-test:
	docker-compose up -d db-test
	docker-compose build test
	$(MAKE) -f Makefile.ai ai-test

ai-env:
	curl -s http://localhost:$(PORT)/env || echo '{"error": "API not running"}'

ai-status:
	docker-compose ps

# --- Database and Migration Targets ---
ai-api-wait:
	@echo "Waiting for API to be ready..."
	@until curl -sf http://localhost:$(API_PORT)/env > /dev/null; do sleep 2; done
	@echo "API is up!"

# --- Enhancement and Bug Report Targets ---
ai-list-bug-reports:
	curl -s http://localhost:$(PORT)/bug-reports | jq '.'

# --- Logs and Admin Targets ---
logs:
	docker compose logs --tail=100 api db-test frontend || docker-compose logs --tail=100 api db-test frontend

open-docs:
	open http://localhost:$(PORT)/docs

open-admin:
	open http://localhost:$(ADMIN_FRONTEND_PORT)

ai-build:
	docker-compose build

# --- Restart and Utility Targets ---
ai-api-restart-wait:
	docker compose restart api
	$(MAKE) -f Makefile.ai ai-api-wait

ai-restart-all:
	$(MAKE) -f Makefile.ai ai-api-restart-wait
	$(MAKE) -f Makefile.ai ai-restart-ollama-functions
	$(MAKE) -f Makefile.ai ai-ollama-restart-docker-gateway-bg
	$(MAKE) -f Makefile.ai ai-admin-frontend-restart
	$(MAKE) -f Makefile.ai ai-misc-restart
	@echo "[ai-restart-all] All core services (API, Ollama functions, frontend, misc-scripts) have been restarted."

# --- MemoryDB and Misc Targets ---
ai-memorydb-migrate:
	docker-compose -f docker-compose.test.yml exec test-misc-scripts bash -c 'cd /code && alembic -c alembic_memorydb.ini upgrade head'
	@echo "[ai-memorydb-migrate] MemoryDB migrations complete!"

ai-memory-search-embedding:
	curl -X POST http://localhost:9103/memory/nodes/search \
	  -H "Content-Type: application/json" \
	  -d '{"embedding": $(EMBEDDING), "namespace": "$(NAMESPACE)", "limit": $(LIMIT)}'

# --- Memory Graph Operations ---









# --- End of Deduplicated Makefile.ai ---

submit-rule:
	@echo "Submitting rule proposal from file: $(FILE)"
	curl -X POST http://localhost:9103/propose-rule-change -H 'Content-Type: application/json' --data @$(FILE)

update-project-map:
	docker compose exec misc-scripts python3 /code/scripts/update_project_map.py

# --- Meta-targets for LLM operations ---
ai-ollama-pull-model:
	$(MAKE) -f Makefile.ai-llm ai-ollama-pull-model

ai-build-ollama-functions-service:
	$(MAKE) -f Makefile.ai-llm ai-build-ollama-functions-service

ai-run-ollama-functions-service:
	$(MAKE) -f Makefile.ai-llm ai-run-ollama-functions-service

ai-ollama-serve-docker-gateway:
	$(MAKE) -f Makefile.ai-llm ai-ollama-serve-docker-gateway

ai-ollama-logs:
	$(MAKE) -f Makefile.ai-llm ai-ollama-logs

ai-ollama-kill:
	$(MAKE) -f Makefile.ai-llm ai-ollama-kill

ai-ollama-restart-docker-gateway:
	$(MAKE) -f Makefile.ai-llm ai-ollama-restart-docker-gateway

ai-ollama-restart-docker-gateway-bg:
	$(MAKE) -f Makefile.ai-llm ai-ollama-restart-docker-gateway-bg

ai-build-ollama-functions:
	$(MAKE) -f Makefile.ai-llm ai-build-ollama-functions

ai-up-ollama-functions:
	$(MAKE) -f Makefile.ai-llm ai-up-ollama-functions

ai-restart-ollama-functions:
	$(MAKE) -f Makefile.ai-llm ai-restart-ollama-functions

ai-ollama-functions-health:
	$(MAKE) -f Makefile.ai-llm ai-ollama-functions-health

ai-ollama-functions-logs:
	$(MAKE) -f Makefile.ai-llm ai-ollama-functions-logs

ai-suggest-llm-rules:
	$(MAKE) -f Makefile.ai-llm ai-suggest-llm-rules

ai-suggest-llm-rules-docker:
	$(MAKE) -f Makefile.ai-llm ai-suggest-llm-rules-docker

ai-llm-setup:
	$(MAKE) -f Makefile.ai-llm ai-llm-setup

ai-scan-memory-nodes:
	$(MAKE) -f Makefile.ai-llm ai-scan-memory-nodes

ai-stop-ollama-functions:
	$(MAKE) -f Makefile.ai-llm ai-stop-ollama-functions

ai-down-ollama-functions:
	$(MAKE) -f Makefile.ai-llm ai-down-ollama-functions

# --- Meta-targets for Database Operations ---
.PHONY: ai-db-migrate
ai-db-migrate:
	@echo "[ai-db-migrate] Waiting for api container to be running..."
	@timeout=30; while ! docker compose ps api | grep -q 'Up'; do \
	  sleep 1; timeout=$$((timeout-1)); \
	  if [ $$timeout -le 0 ]; then echo 'api did not start in time.'; exit 1; fi; \
	done
	docker compose exec api alembic upgrade head
	@echo "[ai-db-migrate] DB migrations complete!"

ai-db-revision:
	$(MAKE) -f Makefile.ai-db ai-db-revision

ai-db-backup-full:
	$(MAKE) -f Makefile.ai-db ai-db-backup-full

ai-db-restore-full:
	$(MAKE) -f Makefile.ai-db ai-db-restore-full

# Bring up all test environment containers
.PHONY: test-env-up
test-env-up:
	docker-compose -f docker-compose.test.yml up -d test-db test-api test test-frontend test-misc-scripts test-ollama-functions test-worker
	@echo "[test-env-up] Test environment containers are up!"

# Bring up all dev environment containers
.PHONY: dev-env-up
dev-env-up:
	docker compose up -d db api rabbitmq
	@echo "[dev-env-up] Dev environment containers are up!"

# Run migrations in the test environment (test-api)
.PHONY: test-db-migrate
test-db-migrate:
	@echo "[test-db-migrate] Waiting for test-api container to be running..."
	@timeout=30; while ! docker-compose -f docker-compose.test.yml ps test-api | grep -q 'Up'; do \
	  sleep 1; timeout=$$((timeout-1)); \
	  if [ $$timeout -le 0 ]; then echo 'test-api did not start in time.'; exit 1; fi; \
	done
	docker-compose -f docker-compose.test.yml exec test-api alembic upgrade head
	@echo "[test-db-migrate] Test DB migrations complete!"

# Run migrations in the dev environment (api)
.PHONY: dev-db-migrate
dev-db-migrate:
	@echo "[dev-db-migrate] Waiting for api container to be running..."
	@timeout=30; while ! docker compose ps api | grep -q 'Up'; do \
	  sleep 1; timeout=$$((timeout-1)); \
	  if [ $$timeout -le 0 ]; then echo 'api did not start in time.'; exit 1; fi; \
	done
	docker compose exec api alembic upgrade head
	@echo "[dev-db-migrate] Dev DB migrations complete!"

# --- Quickstart Targets: Dev vs Test ---

# Dev quickstart: sets up dev env, runs migrations, onboard admin, and runs tests
# WARNING: This flow seeds tokens in the DB for local dev. Do NOT use for contract/first-token tests!
.PHONY: dev-quickstart
dev-quickstart:
	@echo "🏴‍☠️  Dev Quickstart: Setting up dev environment, running migrations, onboarding admin, and testing..."
	@echo "[dev-quickstart] WARNING: This flow seeds user/admin tokens in the DB for local dev convenience."
	$(MAKE) -f Makefile.ai dev-env-up
	$(MAKE) -f Makefile.ai dev-db-migrate
	python scripts/onboard_admin.py
	$(MAKE) -f Makefile.ai ai-test
	@echo "\nIf you see green above, you're ready to code! If not, see ONBOARDING_INTERNAL.md for more info and troubleshooting."

# Test quickstart: sets up test env, runs migrations, and runs tests (NO onboarding, NO token seeding)
# SAFE for contract/first-token tests and CI. Always use this for clean test runs!
.PHONY: test-quickstart
test-quickstart: test-env-up test-db-migrate ai-memorydb-migrate ai-test
	@echo "[test-quickstart] Test onboarding complete! (No tokens seeded, DB is clean)"

# Nuke and reset the test DB/services, then run test quickstart (for CI/test cycles)
test-db-nuke:
	docker compose -f docker-compose.test.yml down -v
	SKIP_TOKEN_POLLUTION_GUARD=1 $(MAKE) -f Makefile.ai test-quickstart

# Nuke and reset the dev DB/services, then run dev quickstart (for local dev only)
dev-db-nuke:
	docker compose down -v
	$(MAKE) -f Makefile.ai dev-quickstart
	@echo "Dev DB and admin onboarding complete!"

# Main nuke alias for CI/dev
ai-db-nuke: test-db-nuke

ai-db-nuke-and-restore-data:
	$(MAKE) -f Makefile.ai-db ai-db-nuke-and-restore-data

ai-db-drop-recreate:
	$(MAKE) -f Makefile.ai-db ai-db-drop-recreate

ai-memorydb-backup:
	$(MAKE) -f Makefile.ai-db ai-memorydb-backup

ai-memorydb-restore:
	$(MAKE) -f Makefile.ai-db ai-memorydb-restore

# --- End of Meta-targets ---

# --- Meta-targets for Test Operations ---
ai-test-coverage:
	$(MAKE) -f Makefile.ai-test ai-test-coverage

# --- Meta-targets for Misc Operations ---
ai-export-rules:
	$(MAKE) -f Makefile.ai-misc ai-export-rules

ai-lint-rules:
	$(MAKE) -f Makefile.ai-misc ai-lint-rules

ai-propose-rule:
	$(MAKE) -f Makefile.ai-misc ai-propose-rule

ai-list-rules:
	$(MAKE) -f Makefile.ai-misc ai-list-rules

ai-safe-shutdown:
	$(MAKE) -f Makefile.ai-misc ai-safe-shutdown

ai-logs-help:
	$(MAKE) -f Makefile.ai-admin ai-logs-help

# --- End of Meta-targets ---

ai-search-package:
	docker-compose run --rm test pip-search $(query)

# --- Test Setup Targets ---
ai-test-setup:
	docker-compose -f docker-compose.test.yml up -d test-db test-api test test-frontend test-misc-scripts test-ollama-functions test-worker
	@echo "Waiting for test-api container to be running..."
	@timeout=30; while ! docker-compose -f docker-compose.test.yml ps test-api | grep -q 'Up'; do \
	  sleep 1; timeout=$$((timeout-1)); \
	  if [ $$timeout -le 0 ]; then echo 'test-api did not start in time.'; exit 1; fi; \
	done
	@echo "Checking test database status..."
	@if docker-compose -f docker-compose.test.yml exec test-db psql -U postgres -t -c "SELECT 1 FROM pg_database WHERE datname='rulesdb'" | grep -q 1; then \
		echo "Database 'rulesdb' detected - not creating"; \
	else \
		echo "Creating database 'rulesdb'..."; \
		docker-compose -f docker-compose.test.yml exec test-db psql -U postgres -c "CREATE DATABASE rulesdb"; \
	fi
	@echo "Running database migrations..."
	docker-compose -f docker-compose.test.yml exec test-api alembic upgrade head
	docker-compose -f docker-compose.test.yml exec test-api alembic -c alembic_memorydb.ini upgrade head
	@echo "Test database setup complete!"

ai-test-with-setup: ai-test-setup ai-onboard-admin
	@echo "Running tests..."
	docker-compose -f docker-compose.test.yml run --rm test pytest tests/ --disable-warnings --tb=short

ai-test-with-setup-verbose: ai-test-setup
	@echo "Running tests with verbose output..."
	docker-compose run --rm test pytest tests/ -v --disable-warnings --tb=short

ai-test-with-setup-coverage: ai-test-setup
	@echo "Running tests with coverage..."
	docker-compose run --rm test pytest tests/ --cov=. --cov-report=term-missing --disable-warnings --tb=short

# Restart all main services (API, frontend, db-test, misc-scripts, ollama-functions)
ai-restart:
	docker compose restart

ai-test-clean:
	docker-compose -f docker-compose.test.yml down -v
	docker volume rm rules_postgres_data_test || true

ai-rebuild-api:
	docker-compose build api
	docker-compose up -d api
	$(MAKE) -f Makefile.ai ai-api-wait
	@echo "[ai-rebuild-api] API rebuilt, restarted, and is healthy!"

ai-onboard-admin:
	python scripts/onboard_admin.py

logs-test:
	docker-compose -f docker-compose.test.yml logs --tail=100 test test-api test-db test-frontend test-misc-scripts test-ollama-functions test-worker | cat || true

# Bring down only the test-db container for a clean test DB reset
.PHONY: test-db-down
test-db-down:
	docker-compose -f docker-compose.test.yml down test-db

# Bring up only the test-db container for test DB access
.PHONY: test-db-up
test-db-up:
	docker-compose -f docker-compose.test.yml up -d test-db

# Reset the test-db: down, up, and migrate
.PHONY: test-db-reset
test-db-reset: test-db-down test-db-up
	docker-compose -f docker-compose.test.yml exec test-api alembic upgrade head
	$(MAKE) -f Makefile.ai test-quickstart
	@echo "[test-db-reset] WARNING: This flow is now safe for contract/first-token tests. No tokens will be seeded."

# Tail logs from all test containers for debugging
.PHONY: test-logs
test-logs:
	docker-compose -f docker-compose.test.yml logs -f test test-api test-db test-frontend test-misc-scripts test-ollama-functions test-worker

# Quickstart: bring up test stack, run onboarding, and smoke test
quickstart: ai-env-up ai-db-migrate ai-memorydb-migrate ai-admin-bootstrap ai-test
	@echo "[quickstart] Onboarding complete!"

ai-test-nuke-all:
	docker compose -f docker-compose.test.yml down -v
	docker system prune -af --volumes
	make -f Makefile.ai ai-env-up
	docker-compose -f docker-compose.test.yml exec test-api alembic upgrade head

ai-env-up:
	docker-compose -f docker-compose.test.yml up -d test-db test-api test test-frontend test-misc-scripts test-ollama-functions test-worker
	@echo "[ai-env-up] Test environment containers are up!"

# === AI/Onboarding Shortcuts ===
# --- DEV ENV ---
# make -f Makefile.ai ai-dev-up           # Bring up dev containers (api, db, etc.)
# make -f Makefile.ai ai-dev-db-reset     # Full dev DB reset and migration
# make -f Makefile.ai ai-dev-db-migrate   # Run Alembic migrations on dev DB
#
# --- TEST ENV ---
# make -f Makefile.ai ai-up-test          # Bring up all test containers
# make -f Makefile.ai ai-test-db-reset    # Full test DB reset and migration
# make -f Makefile.ai ai-test-db-migrate  # Run Alembic migrations on test DB
# make -f Makefile.ai ai-test             # Run all tests

# --- DEV ENV TARGETS ---
ai-dev-up:
	docker compose up -d api db

ai-dev-db-reset:
	docker compose down -v
	docker compose up -d db api
	@echo "Waiting for db to be ready..."
	@timeout=30; while ! docker compose exec db pg_isready -U postgres > /dev/null 2>&1; do \
	  sleep 1; timeout=$$((timeout-1)); \
	  if [ $$timeout -le 0 ]; then echo 'db did not become ready in time.'; exit 1; fi; \
	done
	$(MAKE) -f Makefile.ai ai-dev-db-migrate

ai-dev-db-migrate:
	docker compose exec api alembic upgrade head

# --- TEST ENV TARGETS ---
ai-up-test:
	$(MAKE) -f Makefile.ai-test ai-test-up

ai-test-db-reset:
	$(MAKE) -f Makefile.ai-test test-db-reset

ai-test-db-migrate:
	docker-compose -f docker-compose.test.yml exec test-api alembic upgrade head

# --- Docker Compose Profile Targets ---

# Core development environment (API, DB, Frontend, etc.)
dev-up:
	docker compose --profile dev up -d

# LLM/AI features (LLM worker, Ollama, etc.)
llm-up:
	docker compose --profile llm up -d

# All dev + LLM services (for full stack)
all-up:
	docker compose --profile dev --profile llm up -d

# Test environment (test API, test DB, etc.)
test-up:
	docker compose -f docker-compose.test.yml --profile test up -d

# LLM worker in test mode
llm-test-up:
	docker compose -f docker-compose.test.yml --profile llm-test up -d

# All test + LLM-test services
all-test-up:
	docker compose -f docker-compose.test.yml --profile test --profile llm-test up -d

# Stop all running containers (dev and test)
down:
	docker compose down
	docker compose -f docker-compose.test.yml down

# Show running containers
ps:
	docker compose ps
	docker compose -f docker-compose.test.yml ps

# Clean up all stopped containers, networks, and dangling images
prune:
	docker system prune -f

# --- End of Profile Targets ---
