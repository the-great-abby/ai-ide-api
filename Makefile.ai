# Health aliases (already defined in Makefile.ai-health)

# Migration aliases (already defined in Makefile.ai-migration)

# --- Rebuild All Containers Shortcut ---
# Usage: make -f Makefile.ai ai-rebuild-all
ai-rebuild-all:
	docker compose down -v
	docker compose --profile dev --profile llm build
	docker compose --profile dev --profile llm up -d

# --- HELP TARGET ---
# Usage: make -f Makefile.ai help
help:
	@echo "🏴‍☠️ AI-IDE API MAKEFILE HELP"
	@echo ""
	@echo "QUICK START:"
	@echo "  make -f Makefile.ai quickstart    - Full setup for new developers"
	@echo "  make -f Makefile.ai up            - Start core services (API, DB, RabbitMQ)"
	@echo "  make -f Makefile.ai up-full       - Start all services (including LLM, worker, misc-scripts)"
	@echo "  make -f Makefile.ai status        - Check status of all services"
	@echo "  make -f Makefile.ai test          - Run all tests"
	@echo "  make -f Makefile.ai health        - Run health check"
	@echo ""
	@echo "SUB-MAKEFILES:"
	@echo "  test-*        - Testing operations (see Makefile.ai-test)"
	@echo "  db-*          - Database operations (see Makefile.ai-db)"
	@echo "  llm-*         - LLM operations (see Makefile.ai-llm)"
	@echo "  admin-*       - Admin operations (see Makefile.ai-admin)"
	@echo "  memory-*      - Memory operations (see Makefile.ai-memory)"
	@echo "  api-*         - API operations (see Makefile.ai-api)"
	@echo "  health-*      - Health operations (see Makefile.ai-health)"
	@echo "  migration-*   - Migration operations (see Makefile.ai-migration)"
	@echo "  misc-*        - Misc operations (see Makefile.ai-misc)"
	@echo ""
	@echo "GIT HISTORY AWARENESS:"
	@echo "  ai-git-history-awareness-status     - Check awareness growth status"
	@echo "  ai-git-history-awareness-timeline   - View analysis timeline"
	@echo "  ai-git-history-awareness-patterns   - Analyze development patterns"
	@echo "  ai-git-history-awareness-anomalies  - Detect development anomalies"
	@echo "  ai-git-history-awareness-trends     - Analyze development trends"
	@echo "  ai-git-history-awareness-report     - Generate awareness report"
	@echo "  ai-git-history-awareness-export     - Export awareness data"
	@echo "  ai-git-history-awareness-cleanup    - Clean up old analysis nodes"
	@echo "  ai-git-history-awareness-trigger-full - Trigger comprehensive analysis"
	@echo ""
	@echo "GIT HISTORY ANALYSIS MANAGEMENT:"
	@echo "  ai-git-history-status              - Check analysis process status"
	@echo "  ai-git-history-logs                - View worker logs"
	@echo "  ai-git-history-scheduler-logs      - View scheduler logs"
	@echo "  ai-git-history-trigger-daily       - Trigger daily analysis"
	@echo "  ai-git-history-trigger-weekly      - Trigger weekly analysis"
	@echo "  ai-git-history-trigger-sprint      - Trigger sprint analysis"
	@echo "  ai-git-history-trigger-monthly     - Trigger monthly analysis"
	@echo "  ai-git-history-list-results        - List analysis results"
	@echo "  ai-git-history-view-result         - View specific result"
	@echo "  ai-git-history-check-health        - Check system health"
	@echo "  ai-git-history-restart             - Restart analysis services"
	@echo ""
	@echo "For detailed help on any domain, see the corresponding sub-makefile."
	@echo "Example: make -f Makefile.ai-test help"

# Onboarding cleanup: remove all files generated by onboarding
# Usage: make -f Makefile.ai onboarding-cleanup
onboarding-cleanup:
	@echo "🧹 Cleaning up onboarding-generated files..."
	@rm -f .apitoken .api_admin_token .project .projectname .teamname Makefile.external USAGE.md docker-compose.external.yml setup-workers.sh example_memory.txt example_rule.mdc
	@rm -rf worker .vscode
	@echo "✅ Onboarding cleanup complete."

