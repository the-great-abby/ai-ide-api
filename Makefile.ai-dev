# --- Production/Dev Environment Lifecycle Targets ---
ai-up:
#	docker-compose up -d api frontend misc-scripts ollama-functions worker

	docker compose up -d db api frontend misc-scripts ollama-functions worker
	@echo "[test-up] Test environment is up!"

	@echo "[ai-up] Production/dev environment is up!"

ai-down:
	docker-compose down
	@echo "[ai-down] Production/dev environment stopped."

.PHONY: dev-up
# Bring up all main dev services
# Usage: make -f Makefile.ai-dev dev-up

dev-up:
	docker compose up -d api misc-scripts db worker
	@echo "Dev services (api, misc-scripts, db, worker) are up."

# Run the onboarding script inside misc-scripts container
# Usage: make -f Makefile.ai-dev dev-onboard

dev-onboard:
	touch .apitoken
	docker compose exec misc-scripts python /code/scripts/onboard_external.py
	docker compose cp misc-scripts:/code/.apitoken .apitoken
	docker compose cp misc-scripts:/code/.api_info_capture .api_info_capture || echo ".api_info_capture not found in container."
	docker compose cp misc-scripts:/code/.teamname .teamname || echo ".teamname not found in container."
	docker compose cp misc-scripts:/code/.projectname .projectname || echo ".projectname not found in container."
	@echo "Copied .apitoken, .api_info_capture, .teamname, and .projectname from container to host."

dev-onboard-admin:
	docker compose exec misc-scripts python /code/scripts/onboard_admin.py
	@docker compose cp misc-scripts:/code/.api_admin_token . || true
	@docker compose cp misc-scripts:/code/.apitoken . || true
	@docker compose cp misc-scripts:/code/.api_info_capture . || true
	@docker compose cp misc-scripts:/code/.projectname . || true
	@docker compose cp misc-scripts:/code/.teamname . || true
	@echo "[dev-onboard-admin] Admin onboarding complete. Tokens and info copied to host." 