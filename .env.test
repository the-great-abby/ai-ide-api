  # .env.test
ENVIRONMENT=test
POSTGRES_HOST=db-test
POSTGRES_PORT=5432
REDIS_HOST=redis-test
REDIS_PORT=6379
RABBITMQ_HOST=rabbitmq-test
RABBITMQ_PORT=5672
# Add any test-specific overrides here

PYTHONUNBUFFERED=1
PYTHONPATH=/app
POSTGRES_DB=rulesdb
POSTGRES_HOST=test-db
DATABASE_URL=postgresql://postgres:postgres@test-db:5432/rulesdb
OLLAMA_FUNCTIONS_URL=http://test-ollama-functions:8000
CORS_ORIGINS=*
RABBITMQ_URL=amqp://user:password@test-rabbitmq:5672/
ENVIRONMENT=dev

MEMORY_API_URL=http://test-api:8000/memory/nodes

RUNNING_IN_DOCKER=1
PGUSER=postgres
PGPASSWORD=postgres
PGHOST=test-db
PGPORT=5432
OLLAMA_URL=http://host.docker.internal:11434/api/generate
OLLAMA_MODEL=llama3.1:8b-instruct-q6_K