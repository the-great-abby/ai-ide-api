# Test-related targets extracted from Makefile.ai

# --- Test Environment Lifecycle Targets ---
ai-test-up:
	docker-compose -f docker-compose.test.yml up -d db-test test frontend misc-scripts ollama-functions worker
	@echo "[ai-test-up] Test environment is up!"

ai-test-down:
	docker-compose -f docker-compose.test.yml down
	@echo "[ai-test-down] Test environment stopped."

ai-test:
	docker-compose -f docker-compose.test.yml  run --rm -e PYTHONPATH=/app test pytest tests/ --disable-warnings --tb=short

ai-test-json:
	docker-compose -f docker-compose.test.yml  run --rm -e PYTHONPATH=/app test pytest --json-report --json-report-file=pytest-report.json tests/

ai-test-one:
	docker-compose -f docker-compose.test.yml  run --rm -e PYTHONPATH=/app test pytest $(TEST) --disable-warnings --tb=short

ai-test-unit:
	exit 0
	#docker-compose -f docker-compose.test.yml run --rm -e PYTHONPATH=/app test pytest -m unit $(PYTEST_ARGS)

ai-test-integration:
	docker-compose -f docker-compose.test.yml  run --rm -e PYTHONPATH=/app test pytest -m integration $(PYTEST_ARGS)

ai-test-network:
	docker-compose -f docker-compose.test.yml  run --rm -e PYTHONPATH=/app test pytest -m network $(PYTEST_ARGS)

ai-test-cli:
	docker-compose -f docker-compose.test.yml  run --rm -e PYTHONPATH=/app test pytest -m cli $(PYTEST_ARGS)

ai-test-coverage:
	docker-compose -f docker-compose.test.yml  run --rm -e PYTHONPATH=/app test pytest --cov=. --cov-report=term-missing --cov-report=html tests/

.PHONY: ai-test ai-test-json ai-test-one ai-test-unit ai-test-integration ai-test-network ai-test-cli ai-test-coverage 