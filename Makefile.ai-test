# Test-related targets extracted from Makefile.ai

# --- Test Environment Lifecycle Targets ---
test-up:
	docker compose -f docker-compose.test.yml up -d test-db test-api test test-frontend test-misc-scripts test-ollama-functions test-worker
	@echo "[test-up] Test environment is up!"

test-down:
	docker compose -f docker-compose.test.yml down
	@echo "[test-down] Test environment stopped."

# ai-test:
# ai-test-coverage:
# test-db-reset:

test-json:
	docker compose -f docker-compose.test.yml run --rm -e SKIP_TOKEN_POLLUTION_GUARD=1 -e PYTHONPATH=/app test pytest --json-report --json-report-file=pytest-report.json tests/

test-one:
	docker compose -f docker-compose.test.yml run --rm -e SKIP_TOKEN_POLLUTION_GUARD=1 -e PYTHONPATH=/app test pytest $(TEST) --disable-warnings --tb=short

test-unit:
	exit 0
	#docker compose -f docker-compose.test.yml run --rm -e PYTHONPATH=/app test pytest -m unit $(PYTEST_ARGS)

test-integration:
	docker compose -f docker-compose.test.yml run --rm -e SKIP_TOKEN_POLLUTION_GUARD=1 -e PYTHONPATH=/app test pytest -m integration $(PYTEST_ARGS)

test-network:
	docker compose -f docker-compose.test.yml run --rm -e SKIP_TOKEN_POLLUTION_GUARD=1 -e PYTHONPATH=/app test pytest -m network $(PYTEST_ARGS)

test-cli:
	docker compose -f docker-compose.test.yml run --rm -e SKIP_TOKEN_POLLUTION_GUARD=1 -e PYTHONPATH=/app test pytest -m cli $(PYTEST_ARGS)

test-rebuild:
	docker compose -f docker-compose.test.yml build test-db test-api test test-frontend test-misc-scripts test-ollama-functions test-worker
	@echo "[test-rebuild] All test containers rebuilt!"

test-rebuild-with-setup: test-rebuild test-up
	$(MAKE) -f Makefile.ai test-setup
	@echo "[test-rebuild-with-setup] Test containers rebuilt and environment set up!"

# --- Test DB Alembic Migration Targets ---
test-db-migrate:
	docker compose -f docker-compose.test.yml exec test-api alembic upgrade head
	docker compose -f docker-compose.test.yml exec test-api alembic -c alembic_memorydb.ini upgrade head

test-db-revision:
	docker compose -f docker-compose.test.yml exec test-api alembic revision --autogenerate -m "$(MSG)"

test-db-heads:
	docker compose -f docker-compose.test.yml exec test-api alembic heads

test-db-history:
	docker compose -f docker-compose.test.yml exec test-api alembic history --verbose

test-db-stamp-head:
	docker compose -f docker-compose.test.yml exec test-api alembic stamp head

test-memorydb-revision:
	docker compose -f docker-compose.test.yml exec test-api alembic -c alembic_memorydb.ini revision --autogenerate -m "$(MSG)"

# --- Log Targets for Test Containers ---
test-api-logs:
	docker compose -f docker-compose.test.yml logs --tail=100 test-api | cat

test-db-logs:
	docker compose -f docker-compose.test.yml logs --tail=100 test-db | cat

test-ollama-functions-logs:
	docker compose -f docker-compose.test.yml logs --tail=100 test-ollama-functions | cat

# --- Ollama Functions Test Service Targets ---
test-ollama-functions-up:
	docker compose -f docker-compose.test.yml up -d test-ollama-functions

test-ollama-functions-down:
	docker compose -f docker-compose.test.yml stop test-ollama-functions

# --- Alembic Utility Targets for Test DB ---
test-db-current:
	docker compose -f docker-compose.test.yml exec test-api alembic current

# Run a SQL query against the test Postgres DB (AI-friendly)
test-pg-query:
	@echo "Usage: make -f Makefile.ai-test test-pg-query QUERY='<SQL>'"
	@if [ -z "$$QUERY" ]; then \
	  echo 'Error: Please provide a SQL query using QUERY="..."'; \
	  exit 1; \
	fi; \
	docker compose -f docker-compose.test.yml exec test-db psql -U postgres -d postgres -c "$$QUERY" | cat

# Example:
#   make -f Makefile.ai-test test-pg-query QUERY='SELECT * FROM api_access_tokens LIMIT 5;'

# Start the test ollama functions server (required for LLM-related tests)
test-up-ollama-functions:
	docker compose -f docker-compose.test.yml up -d test-ollama-functions

# Stop the test ollama functions server
test-down-ollama-functions:
	docker compose -f docker-compose.test.yml down test-ollama-functions

# Note: LLM-related tests require the ollama functions server to be running.
# See docs/llm_testing.md (Doc the Medic maintains this doc)

test-test:
	docker compose -f docker-compose.test.yml run --rm -e SKIP_TOKEN_POLLUTION_GUARD=1 -e ENVIRONMENT=test -e PYTHONPATH=/app test pytest tests/ --disable-warnings --tb=short $(PYTEST_ARGS)

# Compose file override (default to test)
COMPOSE_FILE ?= docker-compose.test.yml

# --- Quickstart: Full nuke, migrate, and test cycle for new contributors ---
quickstart:
	@echo "[quickstart] Nuking environment..."
	@if [ "$(COMPOSE_FILE)" = "docker-compose.test.yml" ]; then \
	  docker compose -f docker-compose.yml down -v --remove-orphans; \
	else \
	  docker compose -f docker-compose.test.yml down -v --remove-orphans; \
	fi
	docker compose -f $(COMPOSE_FILE) down -v --remove-orphans
	@echo "[quickstart] Bringing up core services..."
	docker compose -f $(COMPOSE_FILE) up -d test-db test-api || docker compose -f $(COMPOSE_FILE) up -d db api
	@echo "[quickstart] Running migrations..."
	@if [ "$(COMPOSE_FILE)" = "docker-compose.test.yml" ]; then \
	  $(MAKE) -f Makefile.ai-test test-db-migrate; \
	else \
	  $(MAKE) -f Makefile.ai-db db-migrate; \
	fi
	$(MAKE) -f Makefile.ai ai-memorydb-migrate
	@echo "[quickstart] Running test suite or health check..."
	@if [ "$(COMPOSE_FILE)" = "docker-compose.test.yml" ]; then \
	  $(MAKE) -f Makefile.ai-test test-test; \
	else \
	  curl -s http://localhost:9103/docs || echo 'Dev API docs not available, check containers.'; \
	fi
	@echo "[quickstart] All done! Review the output above for results."

# Legacy test quickstart for compatibility
# Usage: make -f Makefile.ai-test test-quickstart
# (now just calls quickstart with test compose file)
test-quickstart:
	$(MAKE) -f Makefile.ai-test quickstart COMPOSE_FILE=docker-compose.test.yml

# Dev quickstart for local development
# Usage: make -f Makefile.ai-test dev-quickstart
# (uses docker-compose.yml and dev services)
dev-quickstart:
	$(MAKE) -f Makefile.ai-test quickstart COMPOSE_FILE=docker-compose.yml

# --- Dynamic Test DB Volume Management ---
# Usage: TEST_DB_VOLUME=custom_volume make -f Makefile.ai-test test-db-nuke
# If TEST_DB_VOLUME is not set, a new unique volume name will be generated each time.

# Helper to get date and timestamp
DATE := $(shell date +%Y%m%d)
TIME := $(shell date +%H%M%S)
VOLUME_FILE := .last_test_db_volume

# If TEST_DB_VOLUME is not set, generate a new one with date and time
ifndef TEST_DB_VOLUME
TEST_DB_VOLUME := rules_postgres_data_test_fresh_$(DATE)_$(TIME)
endif

# Save the new volume name for future cleanup
$(shell echo $(TEST_DB_VOLUME) > $(VOLUME_FILE))

# Read the previous volume name (if any)
PREV_VOLUME := $(shell cat $(VOLUME_FILE) 2>/dev/null)

# Nuke target: remove previous volume, create new one, spin up test-db
# Ignores errors if the previous volume does not exist or cannot be removed
# Always uses the current TEST_DB_VOLUME

test-db-nuke:
	@if [ -n "$(PREV_VOLUME)" ] && [ "$(PREV_VOLUME)" != "$(TEST_DB_VOLUME)" ]; then \
	  echo "[test-db-nuke] Removing previous volume: $(PREV_VOLUME)"; \
	  docker volume rm $(PREV_VOLUME) || true; \
	else \
	  echo "[test-db-nuke] No previous volume to remove or using same volume name."; \
	fi
	@echo "[test-db-nuke] Using volume: $(TEST_DB_VOLUME)"
	docker compose -f docker-compose.test.yml down -v
	docker compose -f docker-compose.test.yml build --no-cache test-db
	docker compose -f docker-compose.test.yml up -d test-db

# In docker-compose.test.yml, replace the volume name with $${TEST_DB_VOLUME:-rules_postgres_data_test_fresh}
# Example:
#   - $${TEST_DB_VOLUME:-rules_postgres_data_test_fresh}:/var/lib/postgresql/data

test: test-test

# Start the test frontend service
.PHONY: test-frontend-up
test-frontend-up:
	docker compose -f docker-compose.test.yml up -d test-frontend

.PHONY: test-up test-down test-json test-one test-unit test-integration test-network test-cli test-coverage test-rebuild test-rebuild-with-setup test-db-migrate test-db-revision test-db-heads test-db-history test-db-stamp-head test-memorydb-revision test-api-logs test-db-logs test-ollama-functions-up test-ollama-functions-down test-ollama-functions-logs test-db-current test-pg-query test-up-ollama-functions test-down-ollama-functions test-test test-quickstart test-db-nuke 