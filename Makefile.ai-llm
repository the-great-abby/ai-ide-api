# Set default model if not provided
OLLAMA_MODEL ?= llama3.1:8b-instruct-q6_K

# LLM-related targets (Ollama, GPT-4, Claude, etc.) extracted from Makefile.ai

# --- Test Environment Targets ---
llm-test-ollama-pull-model:
	ollama pull $(OLLAMA_MODEL)

llm-test-build-ollama-functions-service:
	docker compose -f docker-compose.test.yml build test-ollama-functions

llm-test-ollama-serve-docker-gateway:
	@echo "Starting Ollama with OLLAMA_HOST=0.0.0.0..."
	OLLAMA_HOST=0.0.0.0 ollama serve

llm-test-ollama-logs:
	docker compose -f docker-compose.test.yml logs --tail=100 test-ollama-functions | cat

llm-test-ollama-kill:
	pkill -f 'ollama serve' || true

llm-test-ollama-restart-docker-gateway: llm-test-ollama-kill
	$(MAKE) -f Makefile.ai-llm llm-test-ollama-serve-docker-gateway

llm-test-ollama-serve-docker-gateway-bg:
	nohup $(MAKE) -f Makefile.ai-llm llm-test-ollama-serve-docker-gateway &

# --- Dev/Default Environment Targets ---
llm-ollama-pull-model:
	ollama pull $(OLLAMA_MODEL)

llm-build-ollama-functions-service:
	docker compose build ollama-functions

#ai-run-ollama-functions-service: ai-build-ollama-functions-service
#	docker run --rm -e RUNNING_IN_DOCKER=1 \
#	  --add-host=host.docker.internal:host-gateway \
#	  -e OLLAMA_URL=$(OLLAMA_URL) \
#	  -e OLLAMA_MODEL=$(OLLAMA_MODEL) \
#	  -v $(PWD):/code -w /code \
#	  -p 8000:8000 \
#	  $(OLLAMA_FUNCTIONS_IMAGE)

llm-ollama-serve-docker-gateway:
	@echo "Starting Ollama with OLLAMA_HOST=0.0.0.0..."
	OLLAMA_HOST=0.0.0.0 ollama serve

llm-ollama-logs:
	docker compose logs --tail=100 ollama-functions | cat

llm-ollama-kill:
	pkill -f 'ollama serve' || true

llm-ollama-restart-docker-gateway: llm-ollama-kill
	$(MAKE) -f Makefile.ai-llm llm-ollama-serve-docker-gateway

llm-ollama-serve-docker-gateway-bg:
	nohup $(MAKE) -f Makefile.ai-llm llm-ollama-serve-docker-gateway &

llm-build-ollama-functions:
#	docker-compose build test-ollama-functions
	docker-compose build ollama-functions

llm-up-ollama-functions:
#	docker-compose up -d test-ollama-functions
	docker-compose up -d ollama-functions

llm-restart-ollama-functions:
	docker compose --profile llm --profile dev build ollama-functions
	docker compose --profile llm --profile dev up -d ollama-functions

llm-ollama-functions-health:
	curl -s http://localhost:9103/healthz || echo '{"error": "API not running"}'

llm-ollama-functions-logs:
#	docker-compose logs --tail=100 test-ollama-functions
	docker-compose logs --tail=100 ollama-functions

llm-suggest-rules:
	OLLAMA_URL=$(OLLAMA_URL) RULE_API_URL=$(RULE_API_URL) \
	python scripts/suggest_and_propose_rules.py $${TARGET-.}

llm-suggest-rules-docker:
	docker compose run --rm \
	  -e RUNNING_IN_DOCKER=1 \
	  -e OLLAMA_URL=$(OLLAMA_URL) -e RULE_API_URL=$(RULE_API_URL) \
	  ollama-functions python scripts/suggest_and_propose_rules.py $${TARGET-.}

llm-setup:
	@echo "[LLM Setup] Downloading Ollama model if not present..."
	$(MAKE) -f Makefile.ai llm-ollama-pull-model
	@echo "[LLM Setup] Starting Ollama service (docker gateway)..."
	$(MAKE) -f Makefile.ai llm-ollama-serve-docker-gateway &
	@echo "[LLM Setup] Waiting for Ollama service to be ready..."
	@sleep 5
	@echo "[LLM Setup] Verifying Ollama service is running..."
	@if curl -sf http://localhost:11434 | grep -q 'Ollama'; then \
		echo '[LLM Setup] Ollama service is running!'; \
		echo '[LLM Setup] You can now use LLM-powered features.'; \
	else \
		echo '[LLM Setup] ERROR: Ollama service did not start. Please check logs with: make -f Makefile.ai llm-ollama-logs'; \
		exit 1; \
	fi

llm-scan-memory-nodes:
# 	docker compose run --rm test-ollama-functions python /code/scripts/scan_for_memory_node_opportunities.py
	docker compose run --rm ollama-functions python /code/scripts/scan_for_memory_node_opportunities.py

llm-stop-ollama-functions:
	docker compose stop test-ollama-functions
	docker compose stop ollama-functions

llm-down-ollama-functions:
	docker compose rm -sf ollama-functions
	docker compose rm -sf test-ollama-functions

.PHONY: llm-test-ollama-pull-model llm-test-build-ollama-functions-service llm-test-ollama-serve-docker-gateway llm-test-ollama-logs llm-test-ollama-kill llm-test-ollama-restart-docker-gateway llm-test-ollama-serve-docker-gateway-bg llm-ollama-pull-model llm-build-ollama-functions-service llm-ollama-serve-docker-gateway llm-ollama-logs llm-ollama-kill llm-ollama-restart-docker-gateway llm-ollama-serve-docker-gateway-bg llm-build-ollama-functions llm-up-ollama-functions llm-restart-ollama-functions llm-ollama-functions-health llm-ollama-functions-logs llm-suggest-rules llm-suggest-rules-docker llm-setup llm-scan-memory-nodes llm-stop-ollama-functions llm-down-ollama-functions enable-llm-access

# Usage: make -f Makefile.ai-llm enable-llm-access [PROJECT_ID=<project_id>] [ADMIN_TOKEN=<admin_token>]
ADMIN_TOKEN ?= $(shell cat .api_admin_token 2>/dev/null || echo "")
PROJECT_ID ?= $(shell cat .projectname 2>/dev/null || echo "")

enable-llm-access:
	@if [ -z "$(PROJECT_ID)" ] || [ -z "$(ADMIN_TOKEN)" ]; then \
		echo "Usage: make -f Makefile.ai-llm enable-llm-access PROJECT_ID=<project_id> ADMIN_TOKEN=<admin_token>"; \
		echo "  (Defaults: .projectname and .api_admin_token if present)"; \
		exit 1; \
	fi
	@echo "Enabling LLM access for project: $(PROJECT_ID) using admin token: $$(echo $${ADMIN_TOKEN} | cut -c1-6)******"
	RESPONSE=$$(curl -s -w '\n%{{http_code}}' -X PUT http://localhost:9103/projects/$(PROJECT_ID) \
	  -H "Authorization: Bearer $(ADMIN_TOKEN)" \
	  -H "Content-Type: application/json" \
	  -d '{"name": "$(PROJECT_ID)", "has_llm_access": true}'); \
	BODY=$$(echo "$$RESPONSE" | head -n-1); \
	CODE=$$(echo "$$RESPONSE" | tail -n1); \
	if [ "$$CODE" = "200" ]; then \
		echo "✅ LLM access enabled for project $(PROJECT_ID)."; \
		echo "Response: $$BODY"; \
	else \
		echo "❌ Failed to enable LLM access (HTTP $$CODE): $$BODY"; \
		exit 1; \
	fi 