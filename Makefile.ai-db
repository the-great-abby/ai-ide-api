# Database and backup/restore related targets extracted from Makefile.ai

# --- Test Environment Targets ---
db-test-migrate:
	docker compose -f docker-compose.test.yml exec test-api alembic upgrade head
	docker compose -f docker-compose.test.yml exec test-api alembic -c alembic_memorydb.ini upgrade head

db-test-revision:
	docker compose -f docker-compose.test.yml exec test-api alembic revision --autogenerate -m "$(MSG)"

db-test-heads:
	docker compose -f docker-compose.test.yml exec test-api alembic heads

db-test-history:
	docker compose -f docker-compose.test.yml exec test-api alembic history --verbose

db-test-stamp-head:
	docker compose -f docker-compose.test.yml exec test-api alembic stamp head

db-test-memorydb-revision:
	docker compose -f docker-compose.test.yml exec test-api alembic -c alembic_memorydb.ini revision --autogenerate -m "$(MSG)"

db-test-backup-data-only:
	mkdir -p backups
	docker compose -f docker-compose.test.yml exec -T test-db pg_dump --data-only -U postgres -d rulesdb > backups/rulesdb-data-`date +"%Y%m%d-%H%M%S"`.sql

db-test-backup-all:
	docker compose -f docker-compose.test.yml exec test-db pg_dump -U postgres -d rulesdb > backups/rulesdb-$(shell date +%Y%m%d-%H%M%S).sql
	docker compose -f docker-compose.test.yml exec test-db pg_dump -U postgres -d memorydb > backups/memorydb-$(shell date +%Y%m%d-%H%M%S).sql

db-test-restore-data:
	cat $(BACKUP) | docker compose -f docker-compose.test.yml exec -T test-db psql -U postgres -d rulesdb

db-test-restore-all:
	docker compose -f docker-compose.test.yml exec -T test-db psql -U postgres -d rulesdb < $(RULESDB_FILE)
	docker compose -f docker-compose.test.yml exec -T test-db psql -U postgres -d memorydb < $(MEMORYDB_FILE)

db-test-enable-fdw:
	docker compose -f docker-compose.test.yml exec test-db psql -U postgres -d memorydb -c "CREATE EXTENSION IF NOT EXISTS postgres_fdw;"
	docker compose -f docker-compose.test.yml exec test-db psql -U postgres -d rulesdb -c "CREATE EXTENSION IF NOT EXISTS postgres_fdw;"

# --- Dev/Default Environment Targets ---
db-migrate:
	docker compose exec api alembic upgrade head

db-revision:
	docker compose exec api alembic revision --autogenerate -m "$(MSG)"

db-heads:
	docker compose exec api alembic heads

db-history:
	docker compose exec api alembic history --verbose

db-stamp-head:
	docker compose exec api alembic stamp head

db-backup-data-only:
	mkdir -p backups
	docker compose exec -T db pg_dump --data-only -U postgres -d rulesdb > backups/rulesdb-data-`date +"%Y%m%d-%H%M%S"`.sql

db-backup-all:
	docker compose exec db pg_dump -U postgres -d rulesdb > backups/rulesdb-$(shell date +%Y%m%d-%H%M%S).sql
	docker compose exec db pg_dump -U postgres -d memorydb > backups/memorydb-$(shell date +%Y%m%d-%H%M%S).sql

db-restore-data:
	cat $(BACKUP) | docker compose exec -T db psql -U postgres -d rulesdb

db-restore-all:
	docker compose exec -T db psql -U postgres -d rulesdb < $(RULESDB_FILE)
	docker compose exec -T db psql -U postgres -d memorydb < $(MEMORYDB_FILE)

db-enable-fdw:
	docker compose exec db psql -U postgres -d memorydb -c "CREATE EXTENSION IF NOT EXISTS postgres_fdw;"
	docker compose exec db psql -U postgres -d rulesdb -c "CREATE EXTENSION IF NOT EXISTS postgres_fdw;"

# Helper to get date and timestamp for dev
DEV_DATE := $(shell date +%Y%m%d)
DEV_TIME := $(shell date +%H%M%S)
DEV_VOLUME_FILE := .last_dev_db_volume

ifndef DEV_DB_VOLUME
DEV_DB_VOLUME := rules_postgres_data_dev_fresh_$(DEV_DATE)_$(DEV_TIME)
endif

$(shell echo $(DEV_DB_VOLUME) > $(DEV_VOLUME_FILE))
DEV_PREV_VOLUME := $(shell cat $(DEV_VOLUME_FILE) 2>/dev/null)

dev-db-nuke:
	@if [ -n "$(DEV_PREV_VOLUME)" ] && [ "$(DEV_PREV_VOLUME)" != "$(DEV_DB_VOLUME)" ]; then \
	  echo "[dev-db-nuke] Removing previous volume: $(DEV_PREV_VOLUME)"; \
	  docker volume rm $(DEV_PREV_VOLUME) || true; \
	else \
	  echo "[dev-db-nuke] No previous volume to remove or using same volume name."; \
	fi
	@echo "[dev-db-nuke] Using volume: $(DEV_DB_VOLUME)"
	docker compose down -v
	docker compose build --no-cache db
	docker compose up -d db

migrations-cleanup:
	find migrations/ -name '__pycache__' -type d -exec rm -rf {} +
	find migrations/ -name '*.pyc' -delete
	find migrations_memorydb/ -name '__pycache__' -type d -exec rm -rf {} +
	find migrations_memorydb/ -name '*.pyc' -delete

# --- Generic DB Query Targets ---
# Usage:
#   make -f Makefile.ai-db db-query QUERY="SELECT * FROM projects;"
#   make -f Makefile.ai-db db-test-query QUERY="SELECT * FROM projects;"
db-query:
	docker compose exec db psql -U postgres -d rulesdb -c "$(QUERY)" | cat

db-test-query:
	docker compose -f docker-compose.test.yml exec test-db psql -U postgres -d rulesdb -c "$(QUERY)" | cat

.PHONY: db-test-migrate db-test-revision db-test-heads db-test-history db-test-stamp-head db-test-memorydb-revision db-test-backup-data-only db-test-backup-all db-test-restore-data db-test-restore-all db-test-enable-fdw db-migrate db-revision db-heads db-history db-stamp-head db-backup-data-only db-backup-all db-restore-data db-restore-all db-enable-fdw 