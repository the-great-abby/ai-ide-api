# Memory utility targets extracted from Makefile.ai-misc
# This file contains all memory-* targets for memorydb and graph operations

# --- Memory Database Migration Targets ---
memorydb-migrate:
	docker compose exec api alembic -c alembic_memorydb.ini upgrade head

memorydb-stamp-head:
	docker compose exec api alembic -c alembic_memorydb.ini stamp head

memorydb-revision:
	docker compose exec api alembic -c alembic_memorydb.ini revision --autogenerate -m "$(MSG)"

memorydb-backup-data-only:
	mkdir -p backups
	docker compose exec -T db pg_dump --data-only -U postgres -d memorydb > backups/memorydb-data-`date +"%Y%m%d-%H%M%S"`.sql

memorydb-restore-data:
	cat $(BACKUP) | docker compose exec -T db psql -U postgres -d memorydb

# --- Test Environment Targets ---
memory-test-utils-build:
	docker compose -f docker-compose.test.yml build test-memory-utils

memory-test-add-node:
	docker compose -f docker-compose.test.yml run --rm -e ENVIRONMENT=test test-memory-utils /scripts/memory_add_node.sh $(NAMESPACE) $(CONTENT) $(EMBEDDING) $(META)

memory-test-add-edge:
	docker compose -f docker-compose.test.yml run --rm -e ENVIRONMENT=test test-memory-utils /scripts/memory_add_edge.sh $(FROM_ID) $(TO_ID) $(REL_TYPE) $(META)

memory-test-list-nodes:
	docker compose -f docker-compose.test.yml run --rm -e ENVIRONMENT=test test-memory-utils /scripts/memory_list_nodes.sh

memory-test-list-edges:
	docker compose -f docker-compose.test.yml run --rm -e ENVIRONMENT=test test-memory-utils /scripts/memory_list_edges.sh

# --- Dev/Default Environment Targets ---
memory-utils-build:
	docker compose build misc-scripts

memory-add-node:
	docker compose exec misc-scripts python3 /scripts/memory_cli.py add-node "$(NAMESPACE)" "$(CONTENT)" --meta "$(META)"

memory-add-edge:
	docker compose exec misc-scripts python3 /scripts/memory_cli.py add-edge "$(FROM_ID)" "$(TO_ID)" "$(REL_TYPE)" --meta "$(META)"

memory-list-nodes:
	docker compose exec misc-scripts python3 /scripts/memory_cli.py list-nodes

memory-list-edges:
	docker compose exec misc-scripts python3 /scripts/memory_cli.py list-edges

memory-traverse-single-hop:
	docker compose exec misc-scripts python3 /scripts/memory_cli.py traverse "$(NODE_ID)"

memory-traverse-multi-hop:
	docker compose exec misc-scripts python3 /scripts/memory_cli.py traverse "$(NODE_ID)" --hops 2

memory-traverse-by-relation:
	docker compose exec misc-scripts python3 /scripts/memory_cli.py traverse "$(NODE_ID)" --relation-type "$(REL_TYPE)"

memory-export-dot:
	docker compose exec misc-scripts python3 /scripts/memory_cli.py export-dot > graph.dot

memory-delete-nodes:
	@if [ -z "$(NAMESPACE)" ]; then \
	  echo 'Deleting ALL memory nodes!'; \
	  docker compose exec misc-scripts python3 /scripts/memory_cli.py delete-nodes; \
	else \
	  echo 'Deleting memory nodes in namespace: $(NAMESPACE)'; \
	  docker compose exec misc-scripts python3 /scripts/memory_cli.py delete-nodes --namespace "$(NAMESPACE)"; \
	fi

memory-create:
	@if [ -z "$(NAME)" ] || [ -z "$(OBSERVATION)" ] || [ -z "$(NAMESPACE)" ]; then \
		echo "[ERROR] Usage: make -f Makefile.ai memory-create NAME=\"...\" OBSERVATION=\"...\" [PROJECT=\"...\"] [NAMESPACE=\"...\"]"; \
		exit 1; \
	fi
	@echo "[memory-create] Creating memory: $(NAME)"
	@docker compose exec misc-scripts python3 /code/scripts/create_memory.py --name "$(NAME)" --observation "$(OBSERVATION)" --project "$(PROJECT)" --namespace "$(NAMESPACE)"

memory-log-git-diff:
	@DIFF_RANGE=$${DIFF_RANGE:-HEAD~1..HEAD}; \
	CONCISE_FLAG=$${CONCISE:-0}; \
	NAME=$${NAME:-"git-diff-$$DIFF_RANGE-`date +%Y%m%d-%H%M%S`"}; \
	OBSERVATION=$${OBSERVATION:-"Code changes for $$DIFF_RANGE summarized by LLM."}; \
	NAMESPACE=$${NAMESPACE:-"ai-ide-api"}; \
	mkdir -p diffs; \
	DIFF_FILE=diffs/$$NAME.diff; \
	DIFF=$$(git diff $$DIFF_RANGE); \
	if [ -z "$$DIFF" ]; then echo "[memory-log-git-diff] No changes in diff range: $$DIFF_RANGE"; exit 0; fi; \
	echo "$$DIFF" > "$$DIFF_FILE"; \
	SUMMARY=$$(curl -s -X POST http://localhost:9103/summarize-git-diff -H "Content-Type: application/json" -d "{\"diff\":$$(jq -Rs . <<< \"$$DIFF\"),\"concise\":$$CONCISE_FLAG}" | jq -r .combined); \
	META=$$(jq -nc --arg diff_file "$$DIFF_FILE" --arg summary "$$SUMMARY" --arg diff_range "$$DIFF_RANGE" --arg name "$$NAME" --arg project "ai-ide-api" '{diff_file: $$diff_file, summary: $$summary, diff_range: $$diff_range, name: $$name, project: $$project}'); \
	echo "[DEBUG] META: $$META"; \
	python3 scripts/create_memory.py --name "$$NAME" --observation "$$OBSERVATION" --project "ai-ide-api" --namespace "$$NAMESPACE" --meta "$$META";

memory-list-nodes-summary:
	$(MAKE) -f Makefile.ai memory-list-nodes | awk 'f||/^[[]/{f=1;print}' | jq -c '.[] | select(type == "object") | {name: (.meta.name // .name // ""), project: (.meta.project // .project // ""), namespace, created_at, summary: (.meta.summary // null), content}'

memory-list-nodes-by-namespace:
	@if [ -z "$(NAMESPACE)" ]; then \
		echo "[ERROR] Usage: make -f Makefile.ai memory-list-nodes-by-namespace NAMESPACE=<namespace_name>"; \
		echo "Available namespaces: progress_reports, default, daily_analysis, weekly_analysis, sprint_analysis"; \
		exit 1; \
	fi
	@echo "[memory-list-nodes-by-namespace] Listing nodes in namespace: $(NAMESPACE)"
	@curl -s -X GET "http://localhost:9103/memory/nodes" -H "Authorization: Bearer $$(cat .apitoken)" | jq '.[] | select(.namespace == "$(NAMESPACE)") | {id, namespace, created_at, content: (.content | .[0:200] + "...")}'

memory-list-namespaces:
	@echo "[memory-list-namespaces] Available namespaces:"
	@curl -s -X GET "http://localhost:9103/memory/nodes" -H "Authorization: Bearer $$(cat .apitoken)" | jq -r '.[] | (.namespace // .meta.namespace // "unknown")' | sort | uniq -c | sort -nr

# --- Memory Worker Targets ---

## Progress Report Worker
memory-trigger-progress:
	docker compose exec misc-scripts python3 /scripts/publish_progress_report_job.py

## Memory Cleanup Worker
memory-trigger-cleanup:
	@if [ "$(DRY_RUN)" = "true" ]; then \
		docker compose exec misc-scripts python3 /scripts/publish_memory_cleanup_job.py --dry-run; \
	else \
		docker compose exec misc-scripts python3 /scripts/publish_memory_cleanup_job.py; \
	fi

## Memory Enrichment Worker
memory-trigger-enrichment:
	@if [ -z "$(SCOPE)" ]; then \
		echo "[ERROR] Usage: make -f Makefile.ai memory-trigger-enrichment SCOPE=<all|new|namespace:xyz> [DRY_RUN=true]"; \
		exit 1; \
	fi
	@if [ "$(DRY_RUN)" = "true" ]; then \
		docker compose exec misc-scripts python3 /code/scripts/publish_memory_enrichment_job.py --scope $(SCOPE) --dry-run; \
	else \
		docker compose exec misc-scripts python3 /code/scripts/publish_memory_enrichment_job.py --scope $(SCOPE); \
	fi

## Memory Enrichment Scheduler (Nightly 10pm-2am)
memory-enrichment-scheduler:
	@echo "[memory-enrichment-scheduler] Starting nightly enrichment scheduler..."
	@docker compose exec misc-scripts sh -c 'python3 /code/scripts/memory_enrichment_scheduler.py --scope "$${SCOPE:-all}" $(if $(DRY_RUN),--dry-run,) --similarity-threshold "$${SIMILARITY_THRESHOLD:-0.85}" --max-tags "$${MAX_TAGS:-5}" --batch-size "$${BATCH_SIZE:-50}" --priority "$${PRIORITY:-normal}"'

memory-enrichment-run-now:
	@echo "[memory-enrichment-run-now] Running enrichment job immediately..."
	@docker compose exec misc-scripts sh -c 'python3 /code/scripts/memory_enrichment_scheduler.py --run-now --scope "$${SCOPE:-all}" $(if $(DRY_RUN),--dry-run,) --similarity-threshold "$${SIMILARITY_THRESHOLD:-0.85}" --max-tags "$${MAX_TAGS:-5}" --batch-size "$${BATCH_SIZE:-50}" --priority "$${PRIORITY:-normal}"'

memory-enrichment-scheduler-bg:
	@echo "[memory-enrichment-scheduler-bg] Starting enrichment scheduler in background..."
	@docker compose exec -d misc-scripts sh -c 'python3 /code/scripts/memory_enrichment_scheduler.py --scope "$${SCOPE:-all}" $(if $(DRY_RUN),--dry-run,) --similarity-threshold "$${SIMILARITY_THRESHOLD:-0.85}" --max-tags "$${MAX_TAGS:-5}" --batch-size "$${BATCH_SIZE:-50}" --priority "$${PRIORITY:-normal}" --check-interval "$${CHECK_INTERVAL:-300}"'

memory-enrichment-scheduler-logs:
	@echo "[memory-enrichment-scheduler-logs] Recent scheduler activity..."
	@docker compose logs misc-scripts | grep -i "enrichment\|scheduler" | tail -n 20

memory-enrichment-status:
	@echo "[memory-enrichment-status] Enrichment system status..."
	@echo "\n=== Queue Status ==="
	@docker compose exec rabbitmq rabbitmqctl list_queues | grep "memory.enrichment" || echo "No enrichment queue found"
	@echo "\n=== Recent Enrichment Jobs ==="
	@docker compose logs worker | grep -i "enrichment" | tail -n 10 || echo "No recent enrichment activity"
	@echo "\n=== Scheduler Status ==="
	@docker compose logs misc-scripts | grep -i "scheduler\|nightly" | tail -n 5 || echo "No scheduler activity found"

## Memory Similarity Worker
memory-trigger-similarity:
	@if [ -z "$(SCOPE)" ]; then \
		echo "[ERROR] Usage: make -f Makefile.ai memory-trigger-similarity SCOPE=<all|new|namespace:xyz> [DRY_RUN=true] [VECTOR_THRESHOLD=0.92] [CONTENT_THRESHOLD=0.85] [TAG_THRESHOLD=0.7]"; \
		exit 1; \
	fi
	@CMD="docker compose exec misc-scripts python3 /scripts/publish_memory_similarity_job.py --scope $(SCOPE)"; \
	if [ "$(DRY_RUN)" = "true" ]; then \
		CMD="$$CMD --dry-run"; \
	fi; \
	if [ ! -z "$(VECTOR_THRESHOLD)" ]; then \
		CMD="$$CMD --vector-threshold $(VECTOR_THRESHOLD)"; \
	fi; \
	if [ ! -z "$(CONTENT_THRESHOLD)" ]; then \
		CMD="$$CMD --content-threshold $(CONTENT_THRESHOLD)"; \
	fi; \
	if [ ! -z "$(TAG_THRESHOLD)" ]; then \
		CMD="$$CMD --tag-threshold $(TAG_THRESHOLD)"; \
	fi; \
	eval $$CMD

## Worker Management
memory-restart-workers:
	docker compose restart worker
	@echo "Memory workers restarted."

memory-worker-logs:
	docker compose logs --tail=50 worker

## Monitoring and Health Checks
memory-healthcheck:
	@echo "Running memory system health checks..."
	@docker compose ps worker | grep -q "Up" || (echo "ERROR: Worker container is down" && exit 1)
	@docker compose exec rabbitmq rabbitmqctl list_queues | grep -v "Timeout\|Listing" || true
	@docker compose logs --tail=20 worker | grep -i "error\|warn" || true
	@echo "Health check complete."

memory-status-report:
	@echo "Generating memory system status report..."
	@echo "\nWorker Status:"
	@docker compose ps worker
	@echo "\nQueue Status:"
	@docker compose exec rabbitmq rabbitmqctl list_queues
	@echo "\nRecent Errors:"
	@docker compose logs --tail=100 worker | grep -i "error" || true
	@echo "\nJob Statistics:"
	@curl -s http://localhost:9103/health/jobs || echo "Job stats endpoint not available"

memory-monitor-jobs:
	@echo "Monitoring job completion times..."
	@docker compose logs worker | grep "job completed" | tail -n 10

memory-check-stuck-jobs:
	@echo "Checking for stuck jobs..."
	@docker compose exec rabbitmq rabbitmqctl list_queues | awk '$$2 > 0 {print $$1 " has " $$2 " messages"}'

memory-clear-stuck-jobs:
	@echo "WARNING: This will clear all stuck jobs. Are you sure? (ctrl+c to cancel)"
	@sleep 5
	@docker compose exec rabbitmq rabbitmqctl purge_queue memory.cleanup
	@docker compose exec rabbitmq rabbitmqctl purge_queue memory.enrichment
	@docker compose exec rabbitmq rabbitmqctl purge_queue memory.similarity
	@echo "Cleared stuck jobs from all queues."

memory-requeue-failed:
	@echo "Requeuing failed jobs from dead letter queue..."
	@docker compose exec rabbitmq rabbitmqctl list_queues | grep "dead-letter" | while read queue count; do \
		if [ "$$count" -gt 0 ]; then \
			echo "Moving $$count messages from $$queue"; \
			docker compose exec rabbitmq rabbitmqctl move_messages "$$queue" "$$queue-retry"; \
		fi \
	done

memory-system-recover:
	@echo "Performing full system recovery..."
	@make -f Makefile.ai memory-restart-workers
	@make -f Makefile.ai memory-clear-stuck-jobs
	@make -f Makefile.ai memory-requeue-failed
	@echo "System recovery complete. Check logs for details."

# --- RAG Search Targets ---
memory-rag-search:
	@if [ -z "$(QUERY)" ]; then \
		echo "[ERROR] Usage: make -f Makefile.ai memory-rag-search QUERY=\"your search query\" [NAMESPACE=\"namespace\"] [TOP_K=5] [AUTH_TOKEN=\"override_token\"]"; \
		exit 1; \
	fi
	@echo "[memory-rag-search] Searching: $(QUERY)"
	@TOP_K_VALUE=$${TOP_K:-5}; \
	NAMESPACE_VALUE=$${NAMESPACE:-progress_reports}; \
	if [ -z "$(AUTH_TOKEN)" ]; then \
		if [ -f .api_admin_token ]; then \
			TOKEN=$$(cat .api_admin_token); \
		elif [ -f .apitoken ]; then \
			TOKEN=$$(cat .apitoken); \
		else \
			echo "[ERROR] No auth token found. Please create .api_admin_token or .apitoken, or provide AUTH_TOKEN parameter"; \
			exit 1; \
		fi; \
	else \
		TOKEN="$(AUTH_TOKEN)"; \
	fi; \
	curl -s -X POST http://localhost:9103/memory/rag_search \
		-H "Content-Type: application/json" \
		-H "Authorization: Bearer $$TOKEN" \
		-d "{\"question\": \"$(QUERY)\", \"namespace\": \"$$NAMESPACE_VALUE\", \"top_k\": $$TOP_K_VALUE}" | jq '.'

memory-rag-search-similar:
	@if [ -z "$(NODE_ID)" ]; then \
		echo "[ERROR] Usage: make -f Makefile.ai memory-rag-search-similar NODE_ID=\"node_id\" [TOP_K=5] [AUTH_TOKEN=\"override_token\"]"; \
		exit 1; \
	fi
	@echo "[memory-rag-search-similar] Finding similar nodes to: $(NODE_ID)"
	@TOP_K_VALUE=$${TOP_K:-5}; \
	if [ -z "$(AUTH_TOKEN)" ]; then \
		if [ -f .api_admin_token ]; then \
			TOKEN=$$(cat .api_admin_token); \
		elif [ -f .apitoken ]; then \
			TOKEN=$$(cat .apitoken); \
		else \
			echo "[ERROR] No auth token found. Please create .api_admin_token or .apitoken, or provide AUTH_TOKEN parameter"; \
			exit 1; \
		fi; \
	else \
		TOKEN="$(AUTH_TOKEN)"; \
	fi; \
	curl -s -X POST http://localhost:9103/memory/nodes/similar \
		-H "Content-Type: application/json" \
		-H "Authorization: Bearer $$TOKEN" \
		-d "{\"node_id\": \"$(NODE_ID)\", \"top_k\": $$TOP_K_VALUE}" | jq '.'

# --- End of RAG Search Targets ---

# --- Git History Awareness Growth Targets ---

## Awareness Growth Monitoring
memory-git-history-awareness-status:
	@echo "[memory-git-history-awareness-status] Checking git history awareness growth..."
	@echo "\n=== Analysis Node Counts ==="
	@curl -s -H "Authorization: Bearer $$(cat .apitoken)" http://localhost:9103/memory/nodes | jq '.[] | select(.meta.type == "git_history_analysis") | .namespace' | sort | uniq -c || echo "No analysis nodes found"
	@echo "\n=== Recent Analysis Timeline ==="
	@curl -s -H "Authorization: Bearer $$(cat .apitoken)" http://localhost:9103/memory/nodes | jq '.[] | select(.meta.type == "git_history_analysis") | {namespace: .namespace, date: .created_at, commits: .meta.commits_analyzed}' | jq -s 'sort_by(.date) | .[-10:]' || echo "No recent analysis found"
	@echo "\n=== Awareness Growth Summary ==="
	@curl -s -H "Authorization: Bearer $$(cat .apitoken)" http://localhost:9103/memory/nodes | jq '.[] | select(.meta.type == "git_history_analysis") | .namespace' | sort | uniq -c | awk '{print "  " $$2 ": " $$1 " analyses"}'

memory-git-history-awareness-timeline:
	@echo "[memory-git-history-awareness-timeline] Git history analysis timeline..."
	@curl -s -H "Authorization: Bearer $$(cat .apitoken)" http://localhost:9103/memory/nodes | jq '.[] | select(.meta.type == "git_history_analysis") | {date: .created_at, namespace: .namespace, since: .meta.since, commits: .meta.commits_analyzed}' | jq -s 'sort_by(.date) | .[] | "\(.date) - \(.namespace) (\(.since), \(.commits) commits)"'

memory-git-history-awareness-patterns:
	@echo "[memory-git-history-awareness-patterns] Analyzing development patterns..."
	@echo "\n=== Daily Patterns ==="
	@curl -s -H "Authorization: Bearer $$(cat .apitoken)" http://localhost:9103/memory/nodes | jq '.[] | select(.namespace == "daily_analysis") | .meta.commits_analyzed' | jq -s 'if length > 0 then {avg: (add / length), min: min, max: max, count: length} else "No daily data" end'
	@echo "\n=== Weekly Patterns ==="
	@curl -s -H "Authorization: Bearer $$(cat .apitoken)" http://localhost:9103/memory/nodes | jq '.[] | select(.namespace == "weekly_analysis") | .meta.commits_analyzed' | jq -s 'if length > 0 then {avg: (add / length), min: min, max: max, count: length} else "No weekly data" end'
	@echo "\n=== Sprint Patterns ==="
	@curl -s -H "Authorization: Bearer $$(cat .apitoken)" http://localhost:9103/memory/nodes | jq '.[] | select(.namespace == "sprint_analysis") | .meta.commits_analyzed' | jq -s 'if length > 0 then {avg: (add / length), min: min, max: max, count: length} else "No sprint data" end'

memory-git-history-awareness-anomalies:
	@echo "[memory-git-history-awareness-anomalies] Detecting development anomalies..."
	@echo "\n=== Recent Activity Analysis ==="
	@curl -s -H "Authorization: Bearer $$(cat .apitoken)" http://localhost:9103/memory/nodes | jq '.[] | select(.meta.type == "git_history_analysis") | {date: .created_at, namespace: .namespace, commits: .meta.commits_analyzed}' | jq -s 'sort_by(.date) | .[-5:] | .[] | "\(.date) - \(.namespace): \(.commits) commits"'

memory-git-history-awareness-trends:
	@echo "[memory-git-history-awareness-trends] Analyzing development trends..."
	@echo "\n=== Monthly Trend Analysis ==="
	@curl -s -H "Authorization: Bearer $$(cat .apitoken)" http://localhost:9103/memory/nodes | jq '.[] | select(.namespace == "monthly_analysis") | {date: .created_at, commits: .meta.commits_analyzed, summary: .content}' | jq -s 'sort_by(.date) | .[] | "\(.date) - \(.commits) commits: \(.summary)"'

## Awareness Growth Management
memory-git-history-awareness-cleanup:
	@echo "[memory-git-history-awareness-cleanup] Cleaning up old analysis nodes..."
	@echo "This will remove analysis nodes older than 6 months..."
	@read -p "Continue? (y/N): " confirm && [ "$$confirm" = "y" ] || exit 1
	@curl -s -H "Authorization: Bearer $$(cat .apitoken)" http://localhost:9103/memory/nodes | jq '.[] | select(.meta.type == "git_history_analysis" and (.created_at | fromdateiso8601) < (now - 180*24*60*60)) | .id' | xargs -I {} curl -X DELETE -H "Authorization: Bearer $$(cat .apitoken)" http://localhost:9103/memory/nodes/{} || echo "No old nodes to clean up"

memory-git-history-awareness-export:
	@echo "[memory-git-history-awareness-export] Exporting awareness data..."
	@mkdir -p exports
	@curl -s -H "Authorization: Bearer $$(cat .apitoken)" http://localhost:9103/memory/nodes | jq '.[] | select(.meta.type == "git_history_analysis")' | jq -s > exports/git_history_awareness_$$(date +%Y%m%d_%H%M%S).json
	@echo "Exported to exports/git_history_awareness_$$(date +%Y%m%d_%H%M%S).json"

memory-git-history-awareness-report:
	@echo "[memory-git-history-awareness-report] Generating awareness growth report..."
	@echo "=== Git History Awareness Growth Report ===" > awareness_report_$$(date +%Y%m%d).txt
	@echo "Generated: $$(date)" >> awareness_report_$$(date +%Y%m%d).txt
	@echo "" >> awareness_report_$$(date +%Y%m%d).txt
	@echo "=== Analysis Coverage ===" >> awareness_report_$$(date +%Y%m%d).txt
	@curl -s -H "Authorization: Bearer $$(cat .apitoken)" http://localhost:9103/memory/nodes | jq '.[] | select(.meta.type == "git_history_analysis") | .namespace' | sort | uniq -c >> awareness_report_$$(date +%Y%m%d).txt
	@echo "" >> awareness_report_$$(date +%Y%m%d).txt
	@echo "=== Recent Activity ===" >> awareness_report_$$(date +%Y%m%d).txt
	@curl -s -H "Authorization: Bearer $$(cat .apitoken)" http://localhost:9103/memory/nodes | jq '.[] | select(.meta.type == "git_history_analysis") | {date: .created_at, namespace: .namespace, commits: .meta.commits_analyzed}' | jq -s 'sort_by(.date) | .[-10:] | .[] | "\(.date) - \(.namespace): \(.commits) commits"' >> awareness_report_$$(date +%Y%m%d).txt
	@echo "Report saved to awareness_report_$$(date +%Y%m%d).txt"

## Awareness Growth Triggers
memory-git-history-awareness-trigger-full:
	@echo "[memory-git-history-awareness-trigger-full] Triggering comprehensive awareness analysis..."
	@make -f Makefile.ai misc-git-history-trigger SINCE='1 day ago' CREATE_MEMORY=true MEMORY_NAMESPACE=daily_analysis MEMORY_TAGS='daily automated awareness'
	@make -f Makefile.ai misc-git-history-trigger SINCE='1 week ago' CREATE_MEMORY=true MEMORY_NAMESPACE=weekly_analysis MEMORY_TAGS='weekly retrospective awareness'
	@make -f Makefile.ai misc-git-history-trigger SINCE='2 weeks ago' CREATE_MEMORY=true MEMORY_NAMESPACE=sprint_analysis MEMORY_TAGS='sprint retrospective awareness'
	@make -f Makefile.ai misc-git-history-trigger SINCE='1 month ago' CREATE_MEMORY=true MEMORY_NAMESPACE=monthly_analysis MEMORY_TAGS='monthly detailed awareness'
	@echo "Comprehensive awareness analysis triggered"

memory-git-history-awareness-trigger-custom:
	@if [ -z "$(SINCE)" ] || [ -z "$(NAMESPACE)" ]; then \
		echo "[ERROR] Usage: make -f Makefile.ai memory-git-history-awareness-trigger-custom SINCE='1 week ago' NAMESPACE=custom_analysis [MEMORY_TAGS='tag1 tag2']"; \
		exit 1; \
	fi
	@echo "[memory-git-history-awareness-trigger-custom] Triggering custom awareness analysis..."
	@make -f Makefile.ai misc-git-history-trigger SINCE='$(SINCE)' CREATE_MEMORY=true MEMORY_NAMESPACE=$(NAMESPACE) MEMORY_TAGS='$(MEMORY_TAGS) awareness custom'

memory-list-git-history-analysis:
	@echo "[memory-list-git-history-analysis] Git history analysis nodes by namespace:"
	@curl -s -H "Authorization: Bearer $$(cat .apitoken)" http://localhost:9103/memory/nodes | jq '.[] | select(.meta.type == "git_history_analysis") | .namespace' | sort | uniq -c || echo "No analysis nodes found"

memory-list-recent-git-history:
	@echo "[memory-list-recent-git-history] Recent git history analysis:"
	@curl -s -H "Authorization: Bearer $$(cat .apitoken)" http://localhost:9103/memory/nodes | jq '.[] | select(.meta.type == "git_history_analysis") | {namespace: .namespace, date: .created_at, commits: .meta.commits_analyzed}' | jq -s 'sort_by(.date) | .[-10:]' || echo "No recent analysis found"

memory-list-git-history-namespaces:
	@echo "[memory-list-git-history-namespaces] Git history analysis by namespace:"
	@curl -s -H "Authorization: Bearer $$(cat .apitoken)" http://localhost:9103/memory/nodes | jq '.[] | select(.meta.type == "git_history_analysis") | .namespace' | sort | uniq -c | awk '{print "  " $$2 ": " $$1 " analyses"}'

memory-list-git-history-detailed:
	@echo "[memory-list-git-history-detailed] Detailed git history analysis:"
	@curl -s -H "Authorization: Bearer $$(cat .apitoken)" http://localhost:9103/memory/nodes | jq '.[] | select(.meta.type == "git_history_analysis") | {date: .created_at, namespace: .namespace, since: .meta.since, commits: .meta.commits_analyzed}' | jq -s 'sort_by(.date) | .[] | "\(.date) - \(.namespace) (\(.since), \(.commits) commits)"'

memory-stats-daily-analysis:
	@echo "[memory-stats-daily-analysis] Daily analysis statistics:"
	@curl -s -H "Authorization: Bearer $$(cat .apitoken)" http://localhost:9103/memory/nodes | jq '.[] | select(.namespace == "daily_analysis") | .meta.commits_analyzed' | jq -s 'if length > 0 then {avg: (add / length), min: min, max: max, count: length} else "No daily data" end'

memory-stats-weekly-analysis:
	@echo "[memory-stats-weekly-analysis] Weekly analysis statistics:"
	@curl -s -H "Authorization: Bearer $$(cat .apitoken)" http://localhost:9103/memory/nodes | jq '.[] | select(.namespace == "weekly_analysis") | .meta.commits_analyzed' | jq -s 'if length > 0 then {avg: (add / length), min: min, max: max, count: length} else "No weekly data" end'

memory-stats-sprint-analysis:
	@echo "[memory-stats-sprint-analysis] Sprint analysis statistics:"
	@curl -s -H "Authorization: Bearer $$(cat .apitoken)" http://localhost:9103/memory/nodes | jq '.[] | select(.namespace == "sprint_analysis") | .meta.commits_analyzed' | jq -s 'if length > 0 then {avg: (add / length), min: min, max: max, count: length} else "No sprint data" end'

memory-list-recent-analysis:
	@echo "[memory-list-recent-analysis] Recent analysis by namespace:"
	@curl -s -H "Authorization: Bearer $$(cat .apitoken)" http://localhost:9103/memory/nodes | jq '.[] | select(.meta.type == "git_history_analysis") | {date: .created_at, namespace: .namespace, commits: .meta.commits_analyzed}' | jq -s 'sort_by(.date) | .[-5:] | .[] | "\(.date) - \(.namespace): \(.commits) commits"'

memory-list-monthly-analysis:
	@echo "[memory-list-monthly-analysis] Monthly analysis summaries:"
	@curl -s -H "Authorization: Bearer $$(cat .apitoken)" http://localhost:9103/memory/nodes | jq '.[] | select(.namespace == "monthly_analysis") | {date: .created_at, commits: .meta.commits_analyzed, summary: .content}' | jq -s 'sort_by(.date) | .[] | "\(.date) - \(.commits) commits: \(.summary)"'

.PHONY: memory-test-utils-build memory-test-add-node memory-test-add-edge memory-test-list-nodes memory-test-list-edges memory-utils-build memory-add-node memory-add-edge memory-list-nodes memory-list-edges memory-trigger-progress memory-trigger-cleanup memory-trigger-enrichment memory-trigger-similarity memory-restart-workers memory-worker-logs memory-healthcheck memory-status-report memory-monitor-jobs memory-check-stuck-jobs memory-clear-stuck-jobs memory-requeue-failed memory-system-recover 