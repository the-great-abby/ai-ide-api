# Admin/Frontend-related targets extracted from Makefile.ai

# External Project Management
ADMIN_TOKEN ?= $(shell cat .admin_token 2>/dev/null || echo "")
API_BASE ?= http://localhost:9103

admin-frontend-restart:
	docker compose restart frontend

admin-frontend-nocache-restart:
	docker compose build --no-cache frontend
	docker compose restart frontend

admin-rebuild-all:
	docker compose down -v
	docker compose --profile dev --profile llm build
	docker compose --profile dev --profile llm up -d

admin-docs:
	curl -s http://localhost:$(PORT)/docs || echo 'Could not fetch docs. Is the API running?'

admin-open-docs:
	open http://localhost:$(PORT)/docs

admin-open-admin:
	open http://localhost:$(ADMIN_FRONTEND_PORT)

admin-playwright-test:
	docker compose build frontend
	docker compose run --rm playwright

admin-playwright-build-nocache:
	docker compose build --no-cache playwright

admin-onboarding-help:
	@echo "\n==== AI-IDE Onboarding Quick Start ===="
	@echo "1. Fetch the latest OpenAPI docs (API reference):"
	@echo "   make -f Makefile.ai admin-docs"
	@echo "   (or visit http://localhost:9103/docs in your browser)"
	@echo "2. Start all services if needed:"
	@echo "   make -f Makefile.ai up"
	@echo "3. For more onboarding info, see ONBOARDING_OTHER_AI_IDE.md"
	@echo "4. All automation (tests, builds, migrations) MUST run through Makefile.ai targets."
	@echo "5. Use Docker service names and internal ports for all connections."
	@echo "\n==== End Onboarding Quick Start ===="

# External Project Management Targets
admin-external-list:
	@echo "📋 Listing all external projects..."
	@if [ -z "$(ADMIN_TOKEN)" ]; then \
		echo "❌ Error: ADMIN_TOKEN not set. Create .admin_token file or set ADMIN_TOKEN env var."; \
		echo "   Example: echo 'your-admin-token' > .admin_token"; \
		exit 1; \
	fi
	@python scripts/admin_external_projects.py list --admin-token "$(ADMIN_TOKEN)" --api-base "$(API_BASE)"

admin-external-enable-llm:
	@echo "🤖 Enabling LLM access for project $(PROJECT_ID_OR_NAME)..."
	@if [ -z "$(ADMIN_TOKEN)" ]; then \
		echo "❌ Error: ADMIN_TOKEN not set. Create .admin_token file or set ADMIN_TOKEN env var."; \
		exit 1; \
	fi
	@if [ -z "$(PROJECT_ID_OR_NAME)" ]; then \
		echo "❌ Error: PROJECT_ID_OR_NAME not set. Usage: make -f Makefile.ai-admin admin-external-enable-llm PROJECT_ID_OR_NAME=<project_id_or_name>"; \
		echo "   Examples:"; \
		echo "     make -f Makefile.ai-admin admin-external-enable-llm PROJECT_ID_OR_NAME=abc123-def4-5678-90ab-cdef12345678"; \
		echo "     make -f Makefile.ai-admin admin-external-enable-llm PROJECT_ID_OR_NAME=team-xyz-project"; \
		exit 1; \
	fi
	@python scripts/admin_external_projects.py enable-llm "$(PROJECT_ID_OR_NAME)" --admin-token "$(ADMIN_TOKEN)" --api-base "$(API_BASE)"

admin-external-disable-llm:
	@echo "🚫 Disabling LLM access for project $(PROJECT_ID_OR_NAME)..."
	@if [ -z "$(ADMIN_TOKEN)" ]; then \
		echo "❌ Error: ADMIN_TOKEN not set. Create .admin_token file or set ADMIN_TOKEN env var."; \
		exit 1; \
	fi
	@if [ -z "$(PROJECT_ID_OR_NAME)" ]; then \
		echo "❌ Error: PROJECT_ID_OR_NAME not set. Usage: make -f Makefile.ai-admin admin-external-disable-llm PROJECT_ID_OR_NAME=<project_id_or_name>"; \
		echo "   Examples:"; \
		echo "     make -f Makefile.ai-admin admin-external-disable-llm PROJECT_ID_OR_NAME=abc123-def4-5678-90ab-cdef12345678"; \
		echo "     make -f Makefile.ai-admin admin-external-disable-llm PROJECT_ID_OR_NAME=team-xyz-project"; \
		exit 1; \
	fi
	@python scripts/admin_external_projects.py disable-llm "$(PROJECT_ID_OR_NAME)" --admin-token "$(ADMIN_TOKEN)" --api-base "$(API_BASE)"

admin-external-generate-token:
	@echo "🔑 Generating API token for project $(PROJECT_ID_OR_NAME)..."
	@if [ -z "$(ADMIN_TOKEN)" ]; then \
		echo "❌ Error: ADMIN_TOKEN not set. Create .admin_token file or set ADMIN_TOKEN env var."; \
		exit 1; \
	fi
	@if [ -z "$(PROJECT_ID_OR_NAME)" ]; then \
		echo "❌ Error: PROJECT_ID_OR_NAME not set. Usage: make -f Makefile.ai-admin admin-external-generate-token PROJECT_ID_OR_NAME=<project_id_or_name> [DESCRIPTION='token description'] [ROLE=user|admin]"; \
		echo "   Examples:"; \
		echo "     make -f Makefile.ai-admin admin-external-generate-token PROJECT_ID_OR_NAME=abc123-def4-5678-90ab-cdef12345678"; \
		echo "     make -f Makefile.ai-admin admin-external-generate-token PROJECT_ID_OR_NAME=team-xyz-project DESCRIPTION='Team XYZ external token'"; \
		exit 1; \
	fi
	@python scripts/admin_external_projects.py generate-token "$(PROJECT_ID_OR_NAME)" \
		--admin-token "$(ADMIN_TOKEN)" \
		--api-base "$(API_BASE)" \
		--description "$(DESCRIPTION)" \
		--role "$(ROLE)"

admin-external-project-info:
	@echo "📊 Getting project information for $(PROJECT_ID_OR_NAME)..."
	@if [ -z "$(ADMIN_TOKEN)" ]; then \
		echo "❌ Error: ADMIN_TOKEN not set. Create .admin_token file or set ADMIN_TOKEN env var."; \
		exit 1; \
	fi
	@if [ -z "$(PROJECT_ID_OR_NAME)" ]; then \
		echo "❌ Error: PROJECT_ID_OR_NAME not set. Usage: make -f Makefile.ai-admin admin-external-project-info PROJECT_ID_OR_NAME=<project_id_or_name>"; \
		echo "   Examples:"; \
		echo "     make -f Makefile.ai-admin admin-external-project-info PROJECT_ID_OR_NAME=abc123-def4-5678-90ab-cdef12345678"; \
		echo "     make -f Makefile.ai-admin admin-external-project-info PROJECT_ID_OR_NAME=team-xyz-project"; \
		exit 1; \
	fi
	@python scripts/admin_external_projects.py project-info "$(PROJECT_ID_OR_NAME)" --admin-token "$(ADMIN_TOKEN)" --api-base "$(API_BASE)"

admin-external-elevate-user:
	@if [ -z "$(ADMIN_TOKEN)" ]; then \
		echo "❌ Error: ADMIN_TOKEN not set. Create .admin_token file or set ADMIN_TOKEN env var."; \
		exit 1; \
	fi
	@if [ -z "$(PROJECT_ID_OR_NAME)" ]; then \
		echo "❌ Error: PROJECT_ID_OR_NAME not set. Usage: make -f Makefile.ai-admin admin-external-elevate-user PROJECT_ID_OR_NAME=<project_id_or_name> USER_EMAIL=<user_email>"; \
		echo "     make -f Makefile.ai-admin admin-external-elevate-user PROJECT_ID_OR_NAME=team-xyz-project USER_EMAIL=user@example.com"; \
		exit 1; \
	fi
	@if [ -z "$(USER_EMAIL)" ]; then \
		echo "❌ Error: USER_EMAIL not set. Usage: make -f Makefile.ai-admin admin-external-elevate-user PROJECT_ID_OR_NAME=<project_id_or_name> USER_EMAIL=<user_email>"; \
		echo "     make -f Makefile.ai-admin admin-external-elevate-user PROJECT_ID_OR_NAME=team-xyz-project USER_EMAIL=user@example.com"; \
		exit 1; \
	fi
	@echo "Elevating user $(USER_EMAIL) to admin for project $(PROJECT_ID_OR_NAME)..."
	@python scripts/admin_external_projects.py generate-token "$(PROJECT_ID_OR_NAME)" --admin-token "$(ADMIN_TOKEN)" --api-base "$(API_BASE)" --role admin --user "$(USER_EMAIL)"

admin-external-help:
	@echo "\n==== External Project Management ===="
	@echo "Prerequisites:"
	@echo "  1. Create .admin_token file with your admin token:"
	@echo "     echo 'your-admin-token' > .admin_token"
	@echo "  2. Or set ADMIN_TOKEN environment variable"
	@echo ""
	@echo "Available commands:"
	@echo "  admin-external-list                                    - List all external projects"
	@echo "  admin-external-enable-llm PROJECT_ID_OR_NAME=id_or_name - Enable LLM access for project"
	@echo "  admin-external-disable-llm PROJECT_ID_OR_NAME=id_or_name - Disable LLM access for project"
	@echo "  admin-external-generate-token PROJECT_ID_OR_NAME=id_or_name [DESCRIPTION='desc'] [ROLE=user|admin]"
	@echo "                                                          - Generate API token for project"
	@echo "  admin-external-project-info PROJECT_ID_OR_NAME=id_or_name - Get detailed project information"
	@echo "  admin-external-elevate-user PROJECT_ID_OR_NAME=id_or_name USER_EMAIL=email - Generate admin token for user in project"
	@echo ""
	@echo "Project Identification:"
	@echo "  You can use either project IDs (UUIDs) or project names:"
	@echo "  - Project ID: abc123-def4-5678-90ab-cdef12345678"
	@echo "  - Project Name: team-xyz-project"
	@echo ""
	@echo "Examples:"
	@echo "  make -f Makefile.ai-admin admin-external-list"
	@echo "  make -f Makefile.ai-admin admin-external-enable-llm PROJECT_ID_OR_NAME=abc123-def4-5678-90ab-cdef12345678"
	@echo "  make -f Makefile.ai-admin admin-external-enable-llm PROJECT_ID_OR_NAME=team-xyz-project"
	@echo "  make -f Makefile.ai-admin admin-external-generate-token PROJECT_ID_OR_NAME=team-xyz-project DESCRIPTION='Team XYZ token'"
	@echo "  make -f Makefile.ai-admin admin-external-project-info PROJECT_ID_OR_NAME=team-xyz-project"
	@echo "  make -f Makefile.ai-admin admin-external-elevate-user PROJECT_ID_OR_NAME=team-xyz-project USER_EMAIL=user@example.com"
	@echo "\n==== End External Project Management ===="

admin-port-3000-procs:
	@echo "Processes using port 3000:"
	lsof -i :3000 || echo "No process found on port 3000."

admin-docker-stop-all:
	@echo "Stopping all running Docker containers..."
	docker stop $(shell docker ps -q) || echo "No running containers to stop."

admin-kill-port-3000:
	@echo "Killing any process using port 3000..."
	PID=$$(lsof -ti :3000); if [ -n "$$PID" ]; then kill -9 $$PID && echo "Killed process $$PID on port 3000."; else echo "No process found on port 3000."; fi

admin-frontend-volumes:
	@echo "Checking for volume mounts in docker-compose.yml (frontend service):"
	@awk '/frontend:/, /^[^ ]/' docker-compose.yml | grep -A 5 'volumes:' || echo "No volumes found for frontend."

admin-logs:
	docker compose logs --tail=100 api db-test frontend || docker-compose logs --tail=100 api db-test frontend

admin-logs-api:
	docker compose logs --tail=100 api || docker compose logs --tail=100 api

admin-logs-db:
	docker compose logs --tail=100 db-test || docker compose logs --tail=100 db-test

admin-logs-frontend:
	docker compose logs --tail=100 frontend || docker compose logs --tail=100 frontend

.PHONY: admin-frontend-restart admin-frontend-nocache-restart admin-docs admin-open-docs admin-open-admin admin-playwright-test admin-playwright-build-nocache admin-onboarding-help admin-port-3000-procs admin-docker-stop-all admin-kill-port-3000 admin-frontend-volumes admin-logs admin-logs-api admin-logs-db admin-logs-frontend admin-external-list admin-external-enable-llm admin-external-disable-llm admin-external-generate-token admin-external-project-info admin-external-elevate-user admin-external-help 